namespace inheritance_demo;

define module math

  pub fnc add(int a, int b) => int {
    return a + b;
  }

end

define module model

  define class Parent

    pub value() => int {
      return 7;
    }

  end

  define class Child extends Parent
  end

end

pub routine main() => void {
  let answer = math.add(1, 2);
  answer = answer + 4;

  val values = arr[answer, 9];
  val person = obj{name: "oreslang"};
  val inherited = new model.Child();

  stdio.println(values[0]);
  stdio.println(person.name);
  stdio.println(inherited.value());

  return;
}
