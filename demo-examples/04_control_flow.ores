namespace control_flow_demo;

fnc classify(int value) -> String {
  if value < 0; then
    return "negative";
  elif value == 0; then
    return "zero";
  else
    return "positive";
  fi
}

fnc sumTo(int limit) -> int {
  let total = 0;

  for (let i = 0; i <= limit; i = i + 1) {
    total = total + i;
  }

  return total;
}

pub routine main() -> void {
  stdio.println(classify(-1));
  stdio.println(classify(0));
  stdio.println(classify(1));
  stdio.println(sumTo(10));

  return;
}
