// Pull methods are ordinary source methods with suspending bodies. Generic
// async callables are not yet supported by the reference compiler.

// Treat a capacity-1 Channel<bool> as an idempotent latch without consuming it.
//
// A successful immediate read means the latch was already set. We immediately
// restore the token so later probes observe the same state. Both operations are
// try/immediate channel operations, so this helper never suspends or installs a
// waiter. These marker channels are local subscription state, not stream data.
fnc marked(Channel<bool> marker): bool {
  val present = try readch marker;
  if present.is_some(); then
    // Put the marker back: this is a non-destructive state probe.
    try writech marker, true;
    return true;
  fi
  return false;
}

// A source-level notification view: cancelled is distinct from natural end.
define class StreamEvent<T> as
  val String kind;
  pub val Option<T> value;
  constructor(String kind, Option<T> value) {
    self.kind = kind;
    self.value = value;
  }
  pub is_next(): bool { return self.kind == "next"; }
  pub is_complete(): bool { return self.kind == "complete"; }
  pub is_cancelled(): bool { return self.kind == "cancelled"; }
end

define class Subscription<T> as
  val Channel<bool> cancelled = Channel.new<bool>(1);
  val Channel<bool> finished = Channel.new<bool>(1);
  val Channel<bool> pulling = Channel.new<bool>(1);
  val Channel<bool> disposed = Channel.new<bool>(1);

  pub next(): Option<T> {
    if marked(self.cancelled) || marked(self.finished); then
      return None;
    fi
    if !(try writech self.pulling, true); then
      val Result<bool, String> failure = Err("only one outstanding next() is allowed");
      failure.expect("rx_channels.Subscription.next");
    fi
    val Channel<bool> settled = Channel.new<bool>(1);
    try {
      val Option<T> frame = self.pull();
      if frame.is_none(); then
        try writech self.finished, true;
        self.dispose_once();
      fi
      try writech settled, true;
      if marked(self.cancelled); then
        return None;
      fi
      return frame;
    } catch (err) {
      try writech self.finished, true;
      self.dispose_once();
      val Result<Option<T>, Object> failure = Err(err);
      return failure.expect("rx_channels upstream failed");
    } finally {
      if !marked(settled); then
        try writech self.finished, true;
        self.dispose_once();
      fi
      try readch self.pulling;
    }
  }

  pub pull(): Option<T> {
    return None;
  }

  pub dispose(): void {
    return;
  }

  // All termination paths share one cleanup claim, including pending-pull
  // cancellation, natural completion, and the panic/finally path.
  // Internal cleanup claim; consumers should use cancel().
  dispose_once(): void {
    if !(try writech self.disposed, true); then
      return;
    fi
    self.dispose();
    return;
  }

  pub is_cancelled(): bool { return marked(self.cancelled); }
  pub is_complete(): bool { return marked(self.finished) && !marked(self.cancelled); }

  pub next_event(): StreamEvent<T> {
    val Option<T> frame = self.next();
    if frame.is_some(); then
      return new StreamEvent<T>("next", frame);
    fi
    if marked(self.cancelled); then
      return new StreamEvent<T>("cancelled", None);
    fi
    return new StreamEvent<T>("complete", None);
  }

  pub cancel(): bool {
    if marked(self.cancelled) || marked(self.finished); then
      return false;
    fi
    if !(try writech self.cancelled, true); then
      return false;
    fi
    self.dispose_once();
    return true;
  }
end

define class Observable<T> as
  pub subscribe(): Subscription<T> {
    return new Subscription<T>();
  }
end

define class ChannelObservable<T> extends Observable<T> as
  val Channel<Option<T>> input;
  constructor(Channel<Option<T>> input) { self.input = input; }
  pub subscribe(): Subscription<T> { return new ChannelSubscription<T>(self.input); }
end

define class ValuesObservable<T> extends Observable<T> as
  val Array<T> values;
  // Array<T> is move-only on this compiler. Take its ownership rather
  // than pretending rt copy has a Symbol.rtCopy lowering already.
  constructor(Array<T> values) { self.values = values; }
  pub subscribe(): Subscription<T> { return new ValuesSubscription<T>(self.values); }
end

define class ChannelSubscription<T> extends Subscription<T> as
  val Channel<Option<T>> input;
  val Channel<bool> stopped;
  val SelectSet cases;

  constructor(Channel<Option<T>> input) {
    self.input = input;
    self.stopped = Channel.new<bool>(1);
    self.cases = SelectSet.new([SelectCase.read(self.stopped), SelectCase.read(input)]);
  }

  pub pull(): Option<T> {
    val Option<SelectResult> selected_option =
        await (nb select first from self.cases);
    if selected_option.is_none(); then
      return None;
    fi
    val SelectResult selected = selected_option.unwrap();
    val int index = selected.index;
    if index == 0; then
      return None;
    fi
    val Option<T> frame = selected.value;
    return frame;
  }

  pub dispose(): void {
    // Signal before abandoning a pending pull: select detaches its losing
    // input registration. Never close the channel owned by the producer.
    try writech self.stopped, true;
    return;
  }
end

define class ValuesSubscription<T> extends Subscription<T> as
  val Array<T> values;
  val Channel<int> cursor = Channel.new<int>(1);
  val int size;

  constructor(Array<T> values) {
    let int size = 0;
    for const value of values do
      size = size + 1;
    done
    self.values = values;
    self.size = size;
    writech self.cursor, 0;
  }

  pub pull(): Option<T> {
    val int index = readch self.cursor;
    if index >= self.size; then
      writech self.cursor, index;
      return None;
    fi
    val T value = self.values[index];
    writech self.cursor, index + 1;
    return Some(value);
  }
end

pub fnc from_channel<T>(Channel<Option<T>> input): Observable<T> {
  return new ChannelObservable<T>(input);
}

pub fnc from_values<T>(Array<T> values): Observable<T> {
  return new ValuesObservable<T>(values);
}

// Prefer this owned, checked sender when frame-protocol safety matters.
// Raw send(channel)/complete(channel) remain legacy unchecked helpers.
define class FramedSender<T> as
  val Channel<Option<T>> output;
  val Channel<bool> terminal = Channel.new<bool>(1);

  constructor(Channel<Option<T>> output) { self.output = output; }

  pub is_complete(): bool { return marked(self.terminal); }

  pub send(T value): Future<void> {
    if marked(self.terminal); then
      val Result<bool, String> failure = Err("send after completion");
      failure.expect("rx_channels.FramedSender.send");
    fi
    return nb writech self.output, Some(value);
  }

  pub complete(): Future<void> {
    if !(try writech self.terminal, true); then
      val Result<bool, String> failure = Err("duplicate completion");
      failure.expect("rx_channels.FramedSender.complete");
    fi
    val Option<T> end_frame = None;
    return nb writech self.output, end_frame;
  }
end

// The transport and sender never escape; one producer, one subscriber.
pub define class FramedPipe<T> extends Observable<T> as
  val Channel<Option<T>> input;
  val FramedSender<T> writer;
  val Channel<bool> subscribed = Channel.new<bool>(1);

  pub constructor(int capacity) {
    self.input = Channel.new<Option<T>>(capacity);
    self.writer = new FramedSender<T>(self.input);
  }

  pub send(T value): Future<void> { return self.writer.send(value); }
  pub complete(): Future<void> { return self.writer.complete(); }
  pub is_complete(): bool { return self.writer.is_complete(); }

  pub subscribe(): Subscription<T> {
    if !(try writech self.subscribed, true); then
      val Result<bool, String> failure = Err("only one subscriber is allowed");
      failure.expect("rx_channels.FramedPipe.subscribe");
    fi
    return new ChannelSubscription<T>(self.input);
  }
end

pub fnc framed_sender<T>(Channel<Option<T>> output): FramedSender<T> {
  return new FramedSender<T>(output);
}

pub fnc send<T>(Channel<Option<T>> output, T value): Future<void> {
  return nb writech output, Some(value);
}

pub fnc complete<T>(Channel<Option<T>> output): Future<void> {
  val Option<T> terminal = None;
  return nb writech output, terminal;
}

define class MapSubscription<A, B> extends Subscription<B> as
  val Subscription<A> upstream;
  val Fnc<A, B> transform;

  constructor(Subscription<A> upstream, Fnc<A, B> transform) {
    self.upstream = upstream;
    self.transform = transform;
  }

  pub pull(): Option<B> {
    val Option<A> frame = self.upstream.next();
    if frame.is_none(); then
      return None;
    fi
    return Some(self.transform(frame.unwrap()));
  }

  pub dispose(): void {
    self.upstream.cancel();
    return;
  }
end

define class FilterSubscription<T> extends Subscription<T> as
  val Subscription<T> upstream;
  val Fnc<T, bool> predicate;

  constructor(Subscription<T> upstream, Fnc<T, bool> predicate) {
    self.upstream = upstream;
    self.predicate = predicate;
  }

  pub pull(): Option<T> {
    loop {
      val Option<T> frame = self.upstream.next();
      if frame.is_none(); then
        return None;
      fi
      val T value = frame.unwrap();
      if self.predicate(value); then
        return Some(value);
      fi
    }
  }

  pub dispose(): void {
    self.upstream.cancel();
    return;
  }
end

define class TakeSubscription<T> extends Subscription<T> as
  val Subscription<T> upstream;
  val Channel<int> remaining = Channel.new<int>(1);

  constructor(Subscription<T> upstream, int count) {
    self.upstream = upstream;
    if count < 0; then
      val Result<bool, String> failure = Err("take count must be nonnegative");
      failure.expect("rx_channels.take");
    fi
    writech self.remaining, count;
  }

  pub pull(): Option<T> {
    val int count = readch self.remaining;
    if count == 0; then
      writech self.remaining, 0;
      self.upstream.cancel();
      return None;
    fi
    writech self.remaining, count - 1;
    val Option<T> frame = self.upstream.next();
    if count == 1 || frame.is_none(); then
      self.upstream.cancel();
    fi
    return frame;
  }

  pub dispose(): void {
    self.upstream.cancel();
    return;
  }
end

define class MapObservable<A, B> extends Observable<B> as
  val Observable<A> source;
  val Fnc<A, B> transform;
  constructor(Observable<A> source, Fnc<A, B> transform) {
    self.source = source;
    self.transform = transform;
  }
  pub subscribe(): Subscription<B> {
    return new MapSubscription<A, B>(self.source.subscribe(), self.transform);
  }
end

define class FilterObservable<T> extends Observable<T> as
  val Observable<T> source;
  val Fnc<T, bool> predicate;
  constructor(Observable<T> source, Fnc<T, bool> predicate) {
    self.source = source;
    self.predicate = predicate;
  }
  pub subscribe(): Subscription<T> {
    return new FilterSubscription<T>(self.source.subscribe(), self.predicate);
  }
end

define class TakeObservable<T> extends Observable<T> as
  val Observable<T> source;
  val int count;
  constructor(Observable<T> source, int count) {
    self.source = source;
    self.count = count;
  }
  pub subscribe(): Subscription<T> {
    return new TakeSubscription<T>(self.source.subscribe(), self.count);
  }
end

pub fnc map<A, B>(Observable<A> source, Fnc<A, B> transform): Observable<B> {
  return new MapObservable<A, B>(source, transform);
}

pub fnc filter<T>(Observable<T> source, Fnc<T, bool> predicate): Observable<T> {
  return new FilterObservable<T>(source, predicate);
}

pub fnc take<T>(Observable<T> source, int count): Observable<T> {
  return new TakeObservable<T>(source, count);
}

define class MergeSubscription<T> extends Subscription<T> as
  val Channel<bool> stopped = Channel.new<bool>(1);
  val Channel<bool> left_done = Channel.new<bool>(1);
  val Channel<bool> right_done = Channel.new<bool>(1);
  val SelectSet both;
  val SelectSet left_only;
  val SelectSet right_only;

  constructor(Channel<Option<T>> left, Channel<Option<T>> right) {
    self.both = SelectSet.new([
      SelectCase.read(self.stopped), SelectCase.read(left), SelectCase.read(right)
    ]);
    self.left_only = SelectSet.new([SelectCase.read(self.stopped), SelectCase.read(left)]);
    self.right_only = SelectSet.new([SelectCase.read(self.stopped), SelectCase.read(right)]);
  }

  pub pull(): Option<T> {
    loop {
      val bool left_done = marked(self.left_done);
      val bool right_done = marked(self.right_done);
      if left_done && right_done; then
        return None;
      fi
      let SelectSet cases = self.both;
      if left_done; then
        cases = self.right_only;
      elif right_done; then
        cases = self.left_only;
      fi
      val Option<SelectResult> selected_option =
          await (nb select from cases);
      if selected_option.is_none(); then
        return None;
      fi
      val SelectResult selected = selected_option.unwrap();
      val int index = selected.index;
      if index == 0; then
        return None;
      fi
      val Option<T> frame = selected.value;
      if frame.is_some(); then
        return frame;
      fi
      if left_done; then
        try writech self.right_done, true;
      elif right_done || index == 1; then
        try writech self.left_done, true;
      else
        try writech self.right_done, true;
      fi
    }
  }

  pub dispose(): void {
    try writech self.stopped, true;
    return;
  }
end

define class MergeObservable<T> extends Observable<T> as
  val Channel<Option<T>> left;
  val Channel<Option<T>> right;
  constructor(Channel<Option<T>> left, Channel<Option<T>> right) {
    self.left = left;
    self.right = right;
  }
  pub subscribe(): Subscription<T> {
    return new MergeSubscription<T>(self.left, self.right);
  }
end

// FAIR round-robin over reusable sets. Each input has one consumer and sends
// exactly one None after its final Some. Completed inputs leave the selection.
pub fnc merge_channels<T>(Channel<Option<T>> left, Channel<Option<T>> right): Observable<T> {
  return new MergeObservable<T>(left, right);
}

// Future producers keep their own lifetime. Cancellation of this adapter does
// not cancel the shared Future; an already pending pull waits for settlement.
define class FutureSubscription<T> extends Subscription<T> as
  val Future<T> pending;
  val Channel<bool> emitted = Channel.new<bool>(1);
  constructor(Future<T> pending) { self.pending = pending; }
  pub pull(): Option<T> {
    if !(try writech self.emitted, true); then
      return None;
    fi
    val T value = await self.pending;
    return Some(value);
  }
end

define class FutureObservable<T> extends Observable<T> as
  val Future<T> pending;
  constructor(Future<T> pending) { self.pending = pending; }
  pub subscribe(): Subscription<T> { return new FutureSubscription<T>(self.pending); }
end

pub fnc from_future<T>(Future<T> pending): Observable<T> {
  return new FutureObservable<T>(pending);
}

// Compatibility view: empty is None. Use first_required for a failed
// stream-style first() when no element exists.
pub fnc first<T>(Observable<T> source): Option<T> {
  val Subscription<T> sub = source.subscribe();
  try {
    return sub.next();
  } catch (err) {
    val Result<Option<T>, Object> failure = Err(err);
    return failure.expect("rx_channels.first upstream failed");
  } finally {
    sub.cancel();
  }
}

pub fnc first_required<T>(Observable<T> source): T {
  val Option<T> value = first(source);
  if value.is_none(); then
    val Result<T, String> failure = Err("empty stream");
    return failure.expect("rx_channels.first_required");
  fi
  return value.unwrap();
}
