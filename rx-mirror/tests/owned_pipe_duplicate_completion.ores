import * as rx_channels from '../src/rx.ores';
import class FramedPipe from '../src/rx.ores';
pub async fnc main(): void {
  val Option<int> element_type = None;
  val FramedPipe<int> pipe = rx_channels.framed_pipe(1, element_type);
  val Future<void> finished = pipe.complete();
  await finished;
  pipe.complete();
  return;
}
