import * as rx_callbacks from '../src/rx.ores';
import class Observable from '../src/rx.ores';

pub fnc main(): void {
  let int checksum = 0;
  for let iteration = 0; iteration < 20000; iteration++ do
    val Observable<int> source = rx_callbacks.from_values([1, 2, 3, 4, 5, 6, 7, 8]);
    val Fnc<&int, int> twice = |value| -> {
      val int item = value as int;
      return item * 2;
    };
    val Observable<int> doubled = rx_callbacks.map(source, twice);
    val Fnc<&int, bool> above_four = |value| -> {
      val int item = value as int;
      return item > 4;
    };
    val Observable<int> selected = rx_callbacks.filter(doubled, above_four);
    val Observable<int> limited = rx_callbacks.take(selected, 3);
    val Fnc<&int, bool> sink = |value| -> {
      return true;
    };

    // Callback subscribe returns source values consumed. The third accepted
    // value is produced from source item 5, so this contributes five.
    checksum = checksum + rx_callbacks.for_each(limited, sink);
  done

  stdio.println(checksum);
  return;
}
