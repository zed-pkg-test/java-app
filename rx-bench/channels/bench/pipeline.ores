import * as rx_channels from '../src/rx.ores';
import class Observable, Subscription from '../src/rx.ores';

pub async fnc main(): void {
  let int checksum = 0;
  for let iteration = 0; iteration < 20000; iteration++ do
    val Observable<int> source = rx_channels.from_values([1, 2, 3, 4, 5, 6, 7, 8]);
    val Fnc<int, int> twice = |value| -> { return value * 2; };
    val Observable<int> doubled = rx_channels.map(source, twice);
    val Fnc<&int, bool> above_four = |value| -> {
      val int item = value as int;
      return item > 4;
    };
    val Observable<int> selected = rx_channels.filter(doubled, above_four);
    val Observable<int> limited = rx_channels.take(selected, 3);
    val Subscription<int> sub = limited.subscribe();

    loop {
      val Option<int> frame = sub.next();
      if frame.is_none(); then
        break;
      fi
      checksum = checksum + 1;
    }
  done

  stdio.println(checksum);
  return;
}
