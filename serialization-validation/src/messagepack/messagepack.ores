// Native MessagePack dynamic codec.
//
// Supports signed int64, uint64 values that fit Oreslang signed int, UTF-8
// strings, binary, arrays, string-key maps, boolean/null, and extensions.
// Float32/float64 remain explicit errors until exact portable float-bit
// primitives are available.

import class Value, Utf8Text, WireMember, MapEntry, IntParse from '../core/value';
import fnc value_null, value_bool, value_int, value_string, value_bytes, value_array, value_object, value_map, value_extension, value_deep_equal, value_hash, parse_int from '../core/value';
import fnc bytes_equal from '../core/value';
import class DecodeOptions, EncodeOptions, DecodeError, EncodeError, DecodedValue from '../core/options';
import fnc empty_decode_error, decode_error, encode_error, decode_options_valid, encode_options_valid from '../core/options';
import fnc utf8_is_valid from '../core/utf8';
import fnc byte_list_valid, byte_range_fits from '../core/bytes';

define class MsgpackCursor as
  pub val List<int> input;
  pub val DecodeOptions options;
  pub let int index;
  pub let bool failed;
  pub let DecodeError error;
end

define class MsgpackWriter as
  pub let List<int> output;
  pub val EncodeOptions options;
  pub let bool failed;
  pub let EncodeError error;
end

fnc cursor_fail(
  MsgpackCursor mut cursor,
  String code,
  String message
): void {
  if cursor.failed then
    return;
  fi
  cursor.failed = true;
  cursor.error = decode_error(code, cursor.index, message);
  return;
}

fnc writer_fail(
  MsgpackWriter mut writer,
  String code,
  String message
): void {
  if writer.failed then
    return;
  fi
  writer.failed = true;
  writer.error = encode_error(code, message);
  return;
}

fnc read_u8(MsgpackCursor mut cursor): int {
  if cursor.index >= cursor.input.length then
    cursor_fail(cursor, "unexpected_eof", "truncated MessagePack value");
    return 0;
  fi

  let int value = cursor.input[cursor.index];
  if value < 0 || value > 255 then
    cursor_fail(cursor, "invalid_byte", "MessagePack input bytes must be 0..255");
    return 0;
  fi

  cursor.index = cursor.index + 1;
  return value;
}

fnc read_uint_be(MsgpackCursor mut cursor, int width): int {
  let int value = 0;
  let int i = 0;

  loop do
    if i >= width then
      break;
    fi

    let int byte = read_u8(cursor);
    if cursor.failed then
      return 0;
    fi

    value = (value * 256) + byte;
    i = i + 1;
  done

  return value;
}

fnc read_signed(MsgpackCursor mut cursor, int width): int {
  if width == 8 then
    let int first = read_u8(cursor);
    if cursor.failed then
      return 0;
    fi

    let int value = first >= 128 ? first - 256 : first;
    let int i = 1;
    loop do
      if i >= 8 then
        break;
      fi
      value = (value * 256) + read_u8(cursor);
      if cursor.failed then
        return 0;
      fi
      i = i + 1;
    done
    return value;
  fi

  let int raw = read_uint_be(cursor, width);
  if cursor.failed then
    return 0;
  fi

  if width == 1 then
    return raw >= 128 ? raw - 256 : raw;
  fi

  if width == 2 then
    return raw >= 32768 ? raw - 65536 : raw;
  fi

  return raw >= 2147483648 ? raw - 4294967296 : raw;
}

fnc read_uint64_checked(MsgpackCursor mut cursor): int {
  let int first = read_u8(cursor);
  if cursor.failed then
    return 0;
  fi

  if first >= 128 then
    cursor_fail(
      cursor,
      "uint64_range",
      "MessagePack uint64 exceeds Oreslang signed int range"
    );
    return 0;
  fi

  let int value = first;
  let int i = 1;
  loop do
    if i >= 8 then
      break;
    fi
    value = (value * 256) + read_u8(cursor);
    if cursor.failed then
      return 0;
    fi
    i = i + 1;
  done
  return value;
}

fnc read_bytes(
  MsgpackCursor mut cursor,
  int length,
  int limit,
  String limit_code
): List<int> {
  let List<int> output = new List<int>();

  if length < 0 then
    cursor_fail(cursor, "invalid_length", "negative MessagePack length");
    return output;
  fi

  if length > limit then
    cursor_fail(cursor, limit_code, "MessagePack payload exceeds configured limit");
    return output;
  fi

  if !byte_range_fits(cursor.input.length, cursor.index, length) then
    cursor_fail(cursor, "unexpected_eof", "truncated MessagePack payload");
    return output;
  fi

  let int i = 0;
  loop do
    if i >= length then
      break;
    fi
    output.push(cursor.input[cursor.index + i]);
    i = i + 1;
  done

  cursor.index = cursor.index + length;
  return output;
}

fnc map_entry_index(
  List<MapEntry> entries,
  Map<int, List<int>> buckets,
  Value key
): int {
  let int hash = value_hash(key);

  if !buckets.contains(hash) then
    return -1;
  fi

  let List<int> candidates = buckets.get(hash);
  for const index of candidates do
    if value_deep_equal(entries[index].key, key) then
      return index;
    fi
  done

  return -1;
}

fnc remember_map_entry(
  Map<int, List<int>> buckets,
  Value key,
  int index
): void {
  let int hash = value_hash(key);

  if buckets.contains(hash) then
    let List<int> candidates = buckets.get(hash);
    candidates.push(index);
    return;
  fi

  let List<int> candidates = new List<int>();
  candidates.push(index);
  buckets.set(hash, candidates);
  return;
}

fnc map_keys_unique(List<MapEntry> entries): bool {
  let Map<int, List<int>> buckets = new Map<int, List<int>>();
  let int i = 0;

  loop do
    if i >= entries.length then
      break;
    fi

    let MapEntry entry = entries[i];
    if map_entry_index(entries, buckets, entry.key) >= 0 then
      return false;
    fi

    remember_map_entry(buckets, entry.key, i);
    i = i + 1;
  done

  return true;
}

fnc decode_string(
  MsgpackCursor mut cursor,
  int length
): Value {
  let List<int> bytes = read_bytes(
    cursor,
    length,
    cursor.options.max_string_bytes,
    "string_limit"
  );

  if cursor.failed then
    return value_null();
  fi

  if !utf8_is_valid(bytes) then
    cursor_fail(cursor, "invalid_utf8", "MessagePack string contains invalid UTF-8");
    return value_null();
  fi

  return value_string(new Utf8Text(bytes));
}

fnc decode_array(
  MsgpackCursor mut cursor,
  int count,
  int depth
): Value {
  let List<Value> values = new List<Value>();

  if count > cursor.options.max_array_entries then
    cursor_fail(cursor, "array_limit", "MessagePack array exceeds max_array_entries");
    return value_array(values);
  fi

  let int i = 0;
  loop do
    if i >= count then
      break;
    fi

    let Value value = decode_value(cursor, depth + 1);
    if cursor.failed then
      return value_array(values);
    fi

    values.push(value);
    i = i + 1;
  done

  return value_array(values);
}

fnc decode_map(
  MsgpackCursor mut cursor,
  int count,
  int depth
): Value {
  let List<MapEntry> entries = new List<MapEntry>();
  let Map<int, List<int>> buckets = new Map<int, List<int>>();
  let bool all_text_keys = true;

  if count > cursor.options.max_map_entries then
    cursor_fail(cursor, "map_limit", "MessagePack map exceeds max_map_entries");
    return value_map(entries);
  fi

  let int i = 0;
  loop do
    if i >= count then
      break;
    fi

    let Value key = decode_value(cursor, depth + 1);
    if cursor.failed then
      return value_map(entries);
    fi

    let Value member_value = decode_value(cursor, depth + 1);
    if cursor.failed then
      return value_map(entries);
    fi

    if key.kind != 3 then
      all_text_keys = false;
    fi

    let int existing = map_entry_index(entries, buckets, key);
    if existing >= 0 then
      if cursor.options.duplicate_key_policy == 0 then
        cursor_fail(cursor, "duplicate_key", "duplicate MessagePack map key");
        return value_map(entries);
      elseif cursor.options.duplicate_key_policy == 2 then
        entries[existing] = new MapEntry(key, member_value);
      fi
    else
      let int index = entries.length;
      entries.push(new MapEntry(key, member_value));
      remember_map_entry(buckets, key, index);
    fi

    i = i + 1;
  done

  if all_text_keys then
    let List<WireMember> members = new List<WireMember>();
    for const entry of entries do
      members.push(new WireMember(entry.key.string_value, entry.value));
    done
    return value_object(members);
  fi

  return value_map(entries);
}

fnc decode_extension(
  MsgpackCursor mut cursor,
  int length
): Value {
  if length > cursor.options.max_binary_bytes then
    cursor_fail(cursor, "binary_limit", "MessagePack extension exceeds max_binary_bytes");
    return value_null();
  fi

  let int raw_type = read_u8(cursor);
  if cursor.failed then
    return value_null();
  fi

  let int extension_type = raw_type >= 128 ? raw_type - 256 : raw_type;
  let List<int> payload = read_bytes(
    cursor,
    length,
    cursor.options.max_binary_bytes,
    "binary_limit"
  );

  if cursor.failed then
    return value_null();
  fi

  return value_extension(extension_type, payload);
}

fnc decode_value(
  MsgpackCursor mut cursor,
  int depth
): Value {
  if depth > cursor.options.max_depth then
    cursor_fail(cursor, "depth_limit", "MessagePack nesting exceeds max_depth");
    return value_null();
  fi

  let int marker = read_u8(cursor);
  if cursor.failed then
    return value_null();
  fi

  // Positive fixint.
  if marker <= 127 then
    return value_int(marker);
  fi

  // Fixmap.
  if marker >= 128 && marker <= 143 then
    return decode_map(cursor, marker - 128, depth);
  fi

  // Fixarray.
  if marker >= 144 && marker <= 159 then
    return decode_array(cursor, marker - 144, depth);
  fi

  // Fixstr.
  if marker >= 160 && marker <= 191 then
    return decode_string(cursor, marker - 160);
  fi

  // Negative fixint.
  if marker >= 224 then
    return value_int(marker - 256);
  fi

  if marker == 192 then
    return value_null();
  fi
  if marker == 194 then
    return value_bool(false);
  fi
  if marker == 195 then
    return value_bool(true);
  fi

  // Binary.
  if marker == 196 then
    let int length = read_u8(cursor);
    return value_bytes(read_bytes(cursor, length, cursor.options.max_binary_bytes, "binary_limit"));
  fi
  if marker == 197 then
    let int length = read_uint_be(cursor, 2);
    return value_bytes(read_bytes(cursor, length, cursor.options.max_binary_bytes, "binary_limit"));
  fi
  if marker == 198 then
    let int length = read_uint_be(cursor, 4);
    return value_bytes(read_bytes(cursor, length, cursor.options.max_binary_bytes, "binary_limit"));
  fi

  // Ext.
  if marker == 199 then
    return decode_extension(cursor, read_u8(cursor));
  fi
  if marker == 200 then
    return decode_extension(cursor, read_uint_be(cursor, 2));
  fi
  if marker == 201 then
    return decode_extension(cursor, read_uint_be(cursor, 4));
  fi

  // Float32 / Float64 are intentionally explicit unsupported markers.
  if marker == 202 || marker == 203 then
    cursor_fail(
      cursor,
      "unsupported_float",
      "MessagePack float32/float64 require exact float-bit primitives"
    );
    return value_null();
  fi

  // Unsigned integer widths supported by an Oreslang signed int.
  if marker == 204 then
    return value_int(read_u8(cursor));
  fi
  if marker == 205 then
    return value_int(read_uint_be(cursor, 2));
  fi
  if marker == 206 then
    return value_int(read_uint_be(cursor, 4));
  fi
  if marker == 207 then
    return value_int(read_uint64_checked(cursor));
  fi

  // Signed integer widths.
  if marker == 208 then
    return value_int(read_signed(cursor, 1));
  fi
  if marker == 209 then
    return value_int(read_signed(cursor, 2));
  fi
  if marker == 210 then
    return value_int(read_signed(cursor, 4));
  fi
  if marker == 211 then
    return value_int(read_signed(cursor, 8));
  fi

  // Fixed extension widths.
  if marker == 212 then
    return decode_extension(cursor, 1);
  fi
  if marker == 213 then
    return decode_extension(cursor, 2);
  fi
  if marker == 214 then
    return decode_extension(cursor, 4);
  fi
  if marker == 215 then
    return decode_extension(cursor, 8);
  fi
  if marker == 216 then
    return decode_extension(cursor, 16);
  fi

  // Strings.
  if marker == 217 then
    return decode_string(cursor, read_u8(cursor));
  fi
  if marker == 218 then
    return decode_string(cursor, read_uint_be(cursor, 2));
  fi
  if marker == 219 then
    return decode_string(cursor, read_uint_be(cursor, 4));
  fi

  // Arrays and maps.
  if marker == 220 then
    return decode_array(cursor, read_uint_be(cursor, 2), depth);
  fi
  if marker == 221 then
    return decode_array(cursor, read_uint_be(cursor, 4), depth);
  fi
  if marker == 222 then
    return decode_map(cursor, read_uint_be(cursor, 2), depth);
  fi
  if marker == 223 then
    return decode_map(cursor, read_uint_be(cursor, 4), depth);
  fi

  cursor_fail(cursor, "reserved_marker", "reserved or unsupported MessagePack marker");
  return value_null();
}

pub fnc decode(
  List<int> input,
  DecodeOptions options
): Result<DecodedValue, DecodeError> {
  if !decode_options_valid(options) then
    return Err(decode_error("invalid_options", 0, "invalid or unsafe decode options"));
  fi

  if input.length > options.max_input_bytes then
    return Err(decode_error("input_limit", 0, "MessagePack input exceeds max_input_bytes"));
  fi

  if !byte_list_valid(input) then
    return Err(decode_error("invalid_byte", 0, "MessagePack input values must all be bytes 0..255"));
  fi

  let MsgpackCursor cursor = new MsgpackCursor(
    input,
    options,
    0,
    false,
    empty_decode_error()
  );

  let Value value = decode_value(cursor, 0);

  if cursor.failed then
    return Err(cursor.error);
  fi

  if !options.allow_trailing_data && cursor.index != input.length then
    return Err(decode_error("trailing_data", cursor.index, "trailing bytes after MessagePack value"));
  fi

  return Ok(new DecodedValue(value, cursor.index));
}

fnc append_byte(MsgpackWriter mut writer, int byte): void {
  if writer.failed then
    return;
  fi

  if byte < 0 || byte > 255 then
    writer_fail(writer, "invalid_byte", "internal MessagePack byte outside 0..255");
    return;
  fi

  if writer.output.length >= writer.options.max_output_bytes then
    writer_fail(writer, "output_limit", "MessagePack output exceeds max_output_bytes");
    return;
  fi

  writer.output.push(byte);
  return;
}

fnc append_uint_be(
  MsgpackWriter mut writer,
  int value,
  int width
): void {
  let int divisor = 1;
  let int i = 1;

  loop do
    if i >= width then
      break;
    fi
    divisor = divisor * 256;
    i = i + 1;
  done

  let int remaining = value;
  let int j = 0;

  loop do
    if j >= width then
      break;
    fi

    let int byte = remaining / divisor;
    append_byte(writer, byte);
    remaining = remaining % divisor;

    if divisor > 1 then
      divisor = divisor / 256;
    fi

    j = j + 1;
  done

  return;
}

fnc append_signed64(
  MsgpackWriter mut writer,
  int value
): void {
  let List<int> reversed = new List<int>();
  let int current = value;
  let int i = 0;

  loop do
    if i >= 8 then
      break;
    fi

    let int byte = current % 256;
    if byte < 0 then
      byte = byte + 256;
    fi

    reversed.push(byte);
    current = (current - byte) / 256;
    i = i + 1;
  done

  let int j = 7;
  loop do
    if j < 0 then
      break;
    fi
    append_byte(writer, reversed[j]);
    j = j - 1;
  done
  return;
}

fnc append_bytes(
  MsgpackWriter mut writer,
  List<int> bytes
): void {
  for const byte of bytes do
    append_byte(writer, byte);
    if writer.failed then
      return;
    fi
  done
  return;
}

fnc encode_integer(
  MsgpackWriter mut writer,
  int value
): void {
  if value >= 0 && value <= 127 then
    append_byte(writer, value);
    return;
  fi

  if value >= -32 && value < 0 then
    append_byte(writer, 256 + value);
    return;
  fi

  if value >= 0 && value <= 255 then
    append_byte(writer, 204);
    append_byte(writer, value);
    return;
  fi

  if value >= 0 && value <= 65535 then
    append_byte(writer, 205);
    append_uint_be(writer, value, 2);
    return;
  fi

  if value >= 0 && value <= 4294967295 then
    append_byte(writer, 206);
    append_uint_be(writer, value, 4);
    return;
  fi

  if value >= 0 then
    append_byte(writer, 207);
    append_uint_be(writer, value, 8);
    return;
  fi

  if value >= -128 then
    append_byte(writer, 208);
    append_byte(writer, value < 0 ? 256 + value : value);
    return;
  fi

  if value >= -32768 then
    append_byte(writer, 209);
    append_uint_be(writer, value < 0 ? 65536 + value : value, 2);
    return;
  fi

  if value >= -2147483648 then
    append_byte(writer, 210);
    append_uint_be(writer, 4294967296 + value, 4);
    return;
  fi

  append_byte(writer, 211);
  append_signed64(writer, value);
  return;
}

fnc encode_string(
  MsgpackWriter mut writer,
  Utf8Text text
): void {
  if !utf8_is_valid(text.bytes) then
    writer_fail(writer, "invalid_utf8", "cannot encode invalid UTF-8 as MessagePack string");
    return;
  fi

  let int length = text.bytes.length;

  if length <= 31 then
    append_byte(writer, 160 + length);
  elseif length <= 255 then
    append_byte(writer, 217);
    append_byte(writer, length);
  elseif length <= 65535 then
    append_byte(writer, 218);
    append_uint_be(writer, length, 2);
  else
    append_byte(writer, 219);
    append_uint_be(writer, length, 4);
  fi

  append_bytes(writer, text.bytes);
  return;
}

fnc encode_binary(
  MsgpackWriter mut writer,
  List<int> bytes
): void {
  let int length = bytes.length;

  if length <= 255 then
    append_byte(writer, 196);
    append_byte(writer, length);
  elseif length <= 65535 then
    append_byte(writer, 197);
    append_uint_be(writer, length, 2);
  else
    append_byte(writer, 198);
    append_uint_be(writer, length, 4);
  fi

  append_bytes(writer, bytes);
  return;
}

fnc encode_extension(
  MsgpackWriter mut writer,
  Value value
): void {
  if value.extension_type < -128 || value.extension_type > 127 then
    writer_fail(writer, "extension_type", "MessagePack extension type must fit signed byte");
    return;
  fi

  let int length = value.bytes_value.length;

  if length == 1 then
    append_byte(writer, 212);
  elseif length == 2 then
    append_byte(writer, 213);
  elseif length == 4 then
    append_byte(writer, 214);
  elseif length == 8 then
    append_byte(writer, 215);
  elseif length == 16 then
    append_byte(writer, 216);
  elseif length <= 255 then
    append_byte(writer, 199);
    append_byte(writer, length);
  elseif length <= 65535 then
    append_byte(writer, 200);
    append_uint_be(writer, length, 2);
  else
    append_byte(writer, 201);
    append_uint_be(writer, length, 4);
  fi

  append_byte(
    writer,
    value.extension_type < 0 ? 256 + value.extension_type : value.extension_type
  );
  append_bytes(writer, value.bytes_value);
  return;
}

fnc encode_value(
  MsgpackWriter mut writer,
  Value value,
  int depth
): void {
  if writer.failed then
    return;
  fi

  if depth > writer.options.max_depth then
    writer_fail(writer, "depth_limit", "MessagePack encoding exceeds max_depth");
    return;
  fi

  if value.kind == 0 then
    append_byte(writer, 192);
    return;
  fi

  if value.kind == 1 then
    append_byte(writer, value.bool_value ? 195 : 194);
    return;
  fi

  if value.kind == 2 then
    let IntParse parsed = parse_int(value);
    if !parsed.ok then
      writer_fail(
        writer,
        "unsupported_number",
        "MessagePack encoder accepts exact integer number Values on this path"
      );
      return;
    fi
    encode_integer(writer, parsed.value);
    return;
  fi

  if value.kind == 3 then
    encode_string(writer, value.string_value);
    return;
  fi

  if value.kind == 4 then
    encode_binary(writer, value.bytes_value);
    return;
  fi

  if value.kind == 5 then
    let int count = value.array_value.length;

    if count <= 15 then
      append_byte(writer, 144 + count);
    elseif count <= 65535 then
      append_byte(writer, 220);
      append_uint_be(writer, count, 2);
    else
      append_byte(writer, 221);
      append_uint_be(writer, count, 4);
    fi

    for const item of value.array_value do
      encode_value(writer, item, depth + 1);
      if writer.failed then
        return;
      fi
    done
    return;
  fi

  if value.kind == 6 then
    let List<MapEntry> object_entries = new List<MapEntry>();
    for const member of value.object_value do
      object_entries.push(new MapEntry(value_string(member.key), member.value));
    done
    if !map_keys_unique(object_entries) then
      writer_fail(writer, "duplicate_key", "cannot encode MessagePack object with duplicate keys");
      return;
    fi

    let int count = value.object_value.length;

    if count <= 15 then
      append_byte(writer, 128 + count);
    elseif count <= 65535 then
      append_byte(writer, 222);
      append_uint_be(writer, count, 2);
    else
      append_byte(writer, 223);
      append_uint_be(writer, count, 4);
    fi

    for const member of value.object_value do
      encode_string(writer, member.key);
      encode_value(writer, member.value, depth + 1);
      if writer.failed then
        return;
      fi
    done
    return;
  fi

  if value.kind == 8 then
    if !map_keys_unique(value.map_value) then
      writer_fail(writer, "duplicate_key", "cannot encode MessagePack map with duplicate keys");
      return;
    fi

    let int count = value.map_value.length;

    if count <= 15 then
      append_byte(writer, 128 + count);
    elseif count <= 65535 then
      append_byte(writer, 222);
      append_uint_be(writer, count, 2);
    else
      append_byte(writer, 223);
      append_uint_be(writer, count, 4);
    fi

    for const entry of value.map_value do
      encode_value(writer, entry.key, depth + 1);
      encode_value(writer, entry.value, depth + 1);
      if writer.failed then
        return;
      fi
    done
    return;
  fi


  if value.kind == 7 then
    encode_extension(writer, value);
    return;
  fi

  writer_fail(writer, "unsupported_value", "unknown dynamic Value kind");
  return;
}

pub fnc encode(
  Value value,
  EncodeOptions options
): Result<List<int>, EncodeError> {
  if !encode_options_valid(options) then
    return Err(encode_error("invalid_options", "invalid or unsafe encode options"));
  fi

  let MsgpackWriter writer = new MsgpackWriter(
    new List<int>(),
    options,
    false,
    new EncodeError("", "")
  );

  encode_value(writer, value, 0);

  if writer.failed then
    return Err(writer.error);
  fi

  return Ok(writer.output);
}
