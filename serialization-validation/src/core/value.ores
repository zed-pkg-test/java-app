// Shared dynamic wire-value model for JSON, MessagePack, CBOR, and schema-aware adapters.
//
// Oreslang userland is pointer-free: ordinary object arguments are references.
// No address-of, dereference, or pointer arithmetic is used in this library.

define class Utf8Text as
  pub val List<int> bytes;
end

define class WireMember as
  pub val Utf8Text key;
  pub val Value value;
end

define class MapEntry as
  pub val Value key;
  pub val Value value;
end

define class IntParse as
  pub val bool ok;
  pub val int value;
end

define class Value as
  // kind:
  // 0 null, 1 bool, 2 number, 3 utf8 string, 4 bytes,
  // 5 array, 6 string-key object, 7 extension, 8 general map.
  pub val int kind;
  pub val bool bool_value;
  pub val List<int> number_lexeme;
  pub val Utf8Text string_value;
  pub val List<int> bytes_value;
  pub val List<Value> array_value;
  pub val List<WireMember> object_value;
  pub val List<MapEntry> map_value;
  pub val int extension_type;
end

pub fnc null_kind(): int { return 0; }
pub fnc bool_kind(): int { return 1; }
pub fnc number_kind(): int { return 2; }
pub fnc string_kind(): int { return 3; }
pub fnc bytes_kind(): int { return 4; }
pub fnc array_kind(): int { return 5; }
pub fnc object_kind(): int { return 6; }
pub fnc extension_kind(): int { return 7; }
pub fnc map_kind(): int { return 8; }

fnc empty_text(): Utf8Text {
  return new Utf8Text(new List<int>());
}

fnc empty_value_list(): List<Value> {
  return new List<Value>();
}

fnc empty_member_list(): List<WireMember> {
  return new List<WireMember>();
}

fnc empty_map_entries(): List<MapEntry> {
  return new List<MapEntry>();
}

fnc empty_bytes(): List<int> {
  return new List<int>();
}

pub fnc utf8_text(List<int> bytes): Utf8Text {
  return new Utf8Text(bytes);
}

pub fnc value_null(): Value {
  return new Value(
    0,
    false,
    empty_bytes(),
    empty_text(),
    empty_bytes(),
    empty_value_list(),
    empty_member_list(),
    empty_map_entries(),
    0
  );
}

pub fnc value_bool(bool value): Value {
  return new Value(
    1,
    value,
    empty_bytes(),
    empty_text(),
    empty_bytes(),
    empty_value_list(),
    empty_member_list(),
    empty_map_entries(),
    0
  );
}

pub fnc value_number_lexeme(List<int> lexeme): Value {
  return new Value(
    2,
    false,
    lexeme,
    empty_text(),
    empty_bytes(),
    empty_value_list(),
    empty_member_list(),
    empty_map_entries(),
    0
  );
}

pub fnc int_to_decimal_bytes(int value): List<int> {
  let List<int> output = new List<int>();

  if value == 0 then
    output.push(48);
    return output;
  fi

  let int current = value;
  if current < 0 then
    output.push(45);
  fi

  let List<int> reversed = new List<int>();
  loop do
    if current == 0 then
      break;
    fi

    let int digit = current % 10;
    if digit < 0 then
      digit = 0 - digit;
    fi

    reversed.push(48 + digit);
    current = current / 10;
  done

  let int i = reversed.length - 1;
  loop do
    if i < 0 then
      break;
    fi
    output.push(reversed[i]);
    i = i - 1;
  done

  return output;
}

pub fnc value_int(int value): Value {
  return value_number_lexeme(int_to_decimal_bytes(value));
}

pub fnc value_string(Utf8Text value): Value {
  return new Value(
    3,
    false,
    empty_bytes(),
    value,
    empty_bytes(),
    empty_value_list(),
    empty_member_list(),
    empty_map_entries(),
    0
  );
}

pub fnc value_bytes(List<int> value): Value {
  return new Value(
    4,
    false,
    empty_bytes(),
    empty_text(),
    value,
    empty_value_list(),
    empty_member_list(),
    empty_map_entries(),
    0
  );
}

pub fnc value_array(List<Value> values): Value {
  return new Value(
    5,
    false,
    empty_bytes(),
    empty_text(),
    empty_bytes(),
    values,
    empty_member_list(),
    empty_map_entries(),
    0
  );
}

pub fnc value_object(List<WireMember> members): Value {
  return new Value(
    6,
    false,
    empty_bytes(),
    empty_text(),
    empty_bytes(),
    empty_value_list(),
    members,
    empty_map_entries(),
    0
  );
}

pub fnc value_extension(int extension_type, List<int> payload): Value {
  return new Value(
    7,
    false,
    empty_bytes(),
    empty_text(),
    payload,
    empty_value_list(),
    empty_member_list(),
    empty_map_entries(),
    extension_type
  );
}

pub fnc value_map(List<MapEntry> entries): Value {
  return new Value(
    8,
    false,
    empty_bytes(),
    empty_text(),
    empty_bytes(),
    empty_value_list(),
    empty_member_list(),
    entries,
    0
  );
}

pub fnc bytes_equal(List<int> left, List<int> right): bool {
  if left.length != right.length then
    return false;
  fi

  let int i = 0;
  loop do
    if i >= left.length then
      break;
    fi
    if left[i] != right[i] then
      return false;
    fi
    i = i + 1;
  done

  return true;
}

pub fnc text_equal(Utf8Text left, Utf8Text right): bool {
  return bytes_equal(left.bytes, right.bytes);
}

pub fnc object_find_index(Value object, Utf8Text key): int {
  if object.kind != 6 then
    return -1;
  fi

  let int i = 0;
  for const member of object.object_value do
    if text_equal(member.key, key) then
      return i;
    fi
    i = i + 1;
  done

  return -1;
}

pub fnc object_has(Value object, Utf8Text key): bool {
  return object_find_index(object, key) >= 0;
}

pub fnc object_get(Value object, Utf8Text key): Result<Value, String> {
  let int index = object_find_index(object, key);
  if index < 0 then
    return Err("object key not found");
  fi
  return Ok(object.object_value[index].value);
}

fnc hash_mix(int hash, int value): int {
  // Deliberate wrapping integer arithmetic: hashes are bucket selectors only;
  // collisions are always resolved with semantic equality.
  return (hash * 1099511628211) ^ value;
}

pub fnc bytes_hash(List<int> bytes): int {
  let int hash = 1469598103934665603;
  for const byte of bytes do
    hash = hash_mix(hash, byte);
  done
  return hash;
}

pub fnc text_hash(Utf8Text text): int {
  return bytes_hash(text.bytes);
}

pub fnc value_hash(Value value): int {
  return value_hash_bounded(value, 0, 128);
}

fnc value_hash_bounded(
  Value value,
  int depth,
  int max_depth
): int {
  let int hash = hash_mix(1469598103934665603, value.kind);

  if depth > max_depth then
    return hash_mix(hash, 127);
  fi

  if value.kind == 0 then
    return hash;
  fi

  if value.kind == 1 then
    return hash_mix(hash, value.bool_value ? 1 : 0);
  fi

  if value.kind == 2 then
    return hash_mix(hash, bytes_hash(value.number_lexeme));
  fi

  if value.kind == 3 then
    return hash_mix(hash, text_hash(value.string_value));
  fi

  if value.kind == 4 then
    return hash_mix(hash, bytes_hash(value.bytes_value));
  fi

  if value.kind == 5 then
    for const item of value.array_value do
      hash = hash_mix(hash, value_hash_bounded(item, depth + 1, max_depth));
    done
    return hash_mix(hash, value.array_value.length);
  fi

  if value.kind == 6 then
    let int aggregate_xor = 0;
    let int aggregate_sum = 0;

    for const member of value.object_value do
      let int pair_hash = hash_mix(
        text_hash(member.key),
        value_hash_bounded(member.value, depth + 1, max_depth)
      );
      aggregate_xor = aggregate_xor ^ pair_hash;
      aggregate_sum = aggregate_sum + pair_hash;
    done

    hash = hash_mix(hash, aggregate_xor);
    hash = hash_mix(hash, aggregate_sum);
    return hash_mix(hash, value.object_value.length);
  fi

  if value.kind == 7 then
    hash = hash_mix(hash, value.extension_type);
    return hash_mix(hash, bytes_hash(value.bytes_value));
  fi

  if value.kind == 8 then
    let int aggregate_xor = 0;
    let int aggregate_sum = 0;

    for const entry of value.map_value do
      let int pair_hash = hash_mix(
        value_hash_bounded(entry.key, depth + 1, max_depth),
        value_hash_bounded(entry.value, depth + 1, max_depth)
      );
      aggregate_xor = aggregate_xor ^ pair_hash;
      aggregate_sum = aggregate_sum + pair_hash;
    done

    hash = hash_mix(hash, aggregate_xor);
    hash = hash_mix(hash, aggregate_sum);
    return hash_mix(hash, value.map_value.length);
  fi

  return hash;
}

pub fnc value_deep_equal(Value left, Value right): bool {
  return value_deep_equal_bounded(left, right, 0, 128);
}

fnc value_deep_equal_bounded(
  Value left,
  Value right,
  int depth,
  int max_depth
): bool {
  if left == right then
    return true;
  fi

  if depth > max_depth then
    return false;
  fi

  if left.kind != right.kind then
    return false;
  fi

  if left.kind == 0 then
    return true;
  fi

  if left.kind == 1 then
    return left.bool_value == right.bool_value;
  fi

  if left.kind == 2 then
    return bytes_equal(left.number_lexeme, right.number_lexeme);
  fi

  if left.kind == 3 then
    return text_equal(left.string_value, right.string_value);
  fi

  if left.kind == 4 then
    return bytes_equal(left.bytes_value, right.bytes_value);
  fi

  if left.kind == 5 then
    if left.array_value.length != right.array_value.length then
      return false;
    fi

    let int i = 0;
    loop do
      if i >= left.array_value.length then
        break;
      fi
      if !value_deep_equal_bounded(
        left.array_value[i],
        right.array_value[i],
        depth + 1,
        max_depth
      ) then
        return false;
      fi
      i = i + 1;
    done
    return true;
  fi

  if left.kind == 6 then
    if left.object_value.length != right.object_value.length then
      return false;
    fi

    let Map<int, List<int>> buckets = new Map<int, List<int>>();
    let List<bool> used = new List<bool>();
    let int i = 0;

    loop do
      if i >= right.object_value.length then
        break;
      fi

      used.push(false);

      let int hash = text_hash(right.object_value[i].key);
      if buckets.contains(hash) then
        let List<int> indices = buckets.get(hash);
        indices.push(i);
      else
        let List<int> indices = new List<int>();
        indices.push(i);
        buckets.set(hash, indices);
      fi
      i = i + 1;
    done

    for const a of left.object_value do
      let int hash = text_hash(a.key);
      if !buckets.contains(hash) then
        return false;
      fi

      let bool matched = false;
      let List<int> indices = buckets.get(hash);
      for const index of indices do
        if used[index] then
          continue;
        fi

        let WireMember b = right.object_value[index];
        if text_equal(a.key, b.key) &&
           value_deep_equal_bounded(a.value, b.value, depth + 1, max_depth) then
          used[index] = true;
          matched = true;
          break;
        fi
      done

      if !matched then
        return false;
      fi
    done

    return true;
  fi

  if left.kind == 7 then
    if left.extension_type != right.extension_type then
      return false;
    fi
    return bytes_equal(left.bytes_value, right.bytes_value);
  fi

  if left.kind == 8 then
    if left.map_value.length != right.map_value.length then
      return false;
    fi

    let Map<int, List<int>> buckets = new Map<int, List<int>>();
    let List<bool> used = new List<bool>();
    let int i = 0;

    loop do
      if i >= right.map_value.length then
        break;
      fi

      used.push(false);

      let int hash = value_hash_bounded(
        right.map_value[i].key,
        depth + 1,
        max_depth
      );

      if buckets.contains(hash) then
        let List<int> indices = buckets.get(hash);
        indices.push(i);
      else
        let List<int> indices = new List<int>();
        indices.push(i);
        buckets.set(hash, indices);
      fi
      i = i + 1;
    done

    for const a of left.map_value do
      let int hash = value_hash_bounded(a.key, depth + 1, max_depth);
      if !buckets.contains(hash) then
        return false;
      fi

      let bool matched = false;
      let List<int> indices = buckets.get(hash);
      for const index of indices do
        if used[index] then
          continue;
        fi

        let MapEntry b = right.map_value[index];
        if value_deep_equal_bounded(a.key, b.key, depth + 1, max_depth) &&
           value_deep_equal_bounded(a.value, b.value, depth + 1, max_depth) then
          used[index] = true;
          matched = true;
          break;
        fi
      done

      if !matched then
        return false;
      fi
    done

    return true;
  fi

  return false;
}


pub fnc parse_int(Value value): IntParse {
  if value.kind != 2 then
    return new IntParse(false, 0);
  fi

  let List<int> bytes = value.number_lexeme;
  if bytes.length == 0 then
    return new IntParse(false, 0);
  fi

  let int i = 0;
  let bool negative = false;

  if bytes[0] == 45 then
    negative = true;
    i = 1;
    if i >= bytes.length then
      return new IntParse(false, 0);
    fi
  fi

  // Accumulate positive values positively and negative values negatively so
  // the signed minimum does not require a positive 2^63 intermediate.
  let int result = 0;

  loop do
    if i >= bytes.length then
      break;
    fi

    let int byte = bytes[i];
    if byte < 48 || byte > 57 then
      return new IntParse(false, 0);
    fi

    let int digit = byte - 48;

    if negative then
      // min int64 is (-9223372036854775807 - 1)
      val int min_int = -9223372036854775807 - 1;
      if result < (min_int + digit) / 10 then
        return new IntParse(false, 0);
      fi
      result = (result * 10) - digit;
    else
      val int max_int = 9223372036854775807;
      if result > (max_int - digit) / 10 then
        return new IntParse(false, 0);
      fi
      result = (result * 10) + digit;
    fi

    i = i + 1;
  done

  return new IntParse(true, result);
}
