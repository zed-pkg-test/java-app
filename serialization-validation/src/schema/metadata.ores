import class Utf8Text from '../core/value';
import fnc text_equal, text_hash from '../core/value';
import class ValueRule from '../validation/validation';
import fnc value_rule_valid from '../validation/validation';
import fnc utf8_is_valid from '../core/utf8';

define class CodecFieldMeta as
  pub val Utf8Text source_name;
  pub val Utf8Text wire_name;
  pub val int field_number;
  pub val bool required;
  pub val ValueRule validation;
end

define class CodecTypeMeta as
  pub val Utf8Text type_name;
  pub val List<CodecFieldMeta> fields;
  pub val int unknown_field_policy;
end

define class MetadataError as
  pub val String code;
  pub val int field_index;
  pub val String message;
end

define class MetadataCheck as
  pub val bool ok;
  pub val CodecTypeMeta metadata;
  pub val MetadataError error;
end

pub fnc codec_field(Utf8Text source_name, Utf8Text wire_name, int field_number, bool required, ValueRule validation): CodecFieldMeta {
  return new CodecFieldMeta(source_name, wire_name, field_number, required, validation);
}
pub fnc codec_type(Utf8Text type_name, List<CodecFieldMeta> fields, int unknown_field_policy): CodecTypeMeta {
  return new CodecTypeMeta(type_name, fields, unknown_field_policy);
}
pub fnc max_codec_fields(): int { return 4096; }
pub fnc max_codec_name_bytes(): int { return 4096; }

pub fnc check_metadata(CodecTypeMeta metadata): MetadataCheck {
  if metadata.unknown_field_policy < 0 || metadata.unknown_field_policy > 2 then
    return new MetadataCheck(false, metadata, new MetadataError("unknown_field_policy", -1, "unknown-field policy must be ignore(0), reject(1), or preserve(2)"));
  fi
  if metadata.type_name.bytes.length == 0 || metadata.type_name.bytes.length > max_codec_name_bytes() || !utf8_is_valid(rt borrow metadata.type_name.bytes) then
    return new MetadataCheck(false, metadata, new MetadataError("invalid_type_name", -1, "codec type name must be non-empty bounded valid UTF-8"));
  fi
  if metadata.fields.length > max_codec_fields() then
    return new MetadataCheck(false, metadata, new MetadataError("field_limit", -1, "codec metadata exceeds the maximum supported field count"));
  fi

  let Map<int, List<int>> source_buckets = new Map<int, List<int>>();
  let Map<int, List<int>> wire_buckets = new Map<int, List<int>>();
  let Map<int, List<int>> number_buckets = new Map<int, List<int>>();
  let int i = 0;
  loop do
    if i >= metadata.fields.length then break; fi
    let CodecFieldMeta field = metadata.fields[i];
    if field.source_name.bytes.length == 0 || field.source_name.bytes.length > max_codec_name_bytes() || !utf8_is_valid(rt borrow field.source_name.bytes) then
      return new MetadataCheck(false, metadata, new MetadataError("invalid_source_name", i, "codec field source name must be non-empty bounded valid UTF-8"));
    fi
    if field.wire_name.bytes.length == 0 || field.wire_name.bytes.length > max_codec_name_bytes() || !utf8_is_valid(rt borrow field.wire_name.bytes) then
      return new MetadataCheck(false, metadata, new MetadataError("invalid_wire_name", i, "codec field wire name must be non-empty bounded valid UTF-8"));
    fi
    if field.field_number < 0 || field.field_number > 536870911 || (field.field_number >= 19000 && field.field_number <= 19999) then
      return new MetadataCheck(false, metadata, new MetadataError("field_number", i, "field number must be 0 or a non-reserved Protobuf field number"));
    fi
    if !value_rule_valid(rt borrow field.validation) then
      return new MetadataCheck(false, metadata, new MetadataError("invalid_validation_rule", i, "codec field contains an invalid validation rule"));
    fi

    let int source_hash = text_hash(rt borrow field.source_name);
    if source_buckets.contains(source_hash) then
      let List<int> candidates = source_buckets.get(source_hash);
      for const index of candidates do
        if text_equal(rt borrow metadata.fields[index].source_name, rt borrow field.source_name) then
          return new MetadataCheck(false, metadata, new MetadataError("duplicate_source_name", i, "duplicate source field name in codec metadata"));
        fi
      done
      candidates.push(i);
    else
      let List<int> candidates = new List<int>(); candidates.push(i); source_buckets.set(source_hash, candidates);
    fi

    let int wire_hash = text_hash(rt borrow field.wire_name);
    if wire_buckets.contains(wire_hash) then
      let List<int> candidates = wire_buckets.get(wire_hash);
      for const index of candidates do
        if text_equal(rt borrow metadata.fields[index].wire_name, rt borrow field.wire_name) then
          return new MetadataCheck(false, metadata, new MetadataError("duplicate_wire_name", i, "duplicate wire field name in codec metadata"));
        fi
      done
      candidates.push(i);
    else
      let List<int> candidates = new List<int>(); candidates.push(i); wire_buckets.set(wire_hash, candidates);
    fi

    if field.field_number > 0 then
      if number_buckets.contains(field.field_number) then
        return new MetadataCheck(false, metadata, new MetadataError("duplicate_field_number", i, "duplicate Protobuf field number in codec metadata"));
      fi
      let List<int> indices = new List<int>(); indices.push(i); number_buckets.set(field.field_number, indices);
    fi
    i = i + 1;
  done
  return new MetadataCheck(true, metadata, new MetadataError("", -1, ""));
}

pub fnc validate_metadata(CodecTypeMeta metadata): Result<CodecTypeMeta, MetadataError> {
  let MetadataCheck checked = check_metadata(rt borrow metadata);
  if checked.ok then return Ok(metadata); fi
  return Err(checked.error);
}

pub fnc field_by_wire_name(CodecTypeMeta metadata, Utf8Text wire_name): Result<CodecFieldMeta, MetadataError> {
  for const field of metadata.fields do
    if text_equal(rt borrow field.wire_name, rt borrow wire_name) then return Ok(field); fi
  done
  return Err(new MetadataError("unknown_wire_name", -1, "wire field name is not present in codec metadata"));
}

pub fnc field_by_number(CodecTypeMeta metadata, int field_number): Result<CodecFieldMeta, MetadataError> {
  for const field of metadata.fields do
    if field.field_number == field_number && field_number > 0 then return Ok(field); fi
  done
  return Err(new MetadataError("unknown_field_number", -1, "field number is not present in codec metadata"));
}
