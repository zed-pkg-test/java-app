// Reflection-free validation primitives over the shared dynamic Value model.
//
// Generated typed validators can lower annotations/contracts into the same rule
// records so standalone validation and decode-time validation share semantics.

import class Value, Utf8Text, WireMember from '../core/value';
import fnc bytes_equal, text_equal, text_hash, value_deep_equal, value_hash from '../core/value';
import fnc object_find_index from '../core/value';
import fnc utf8_is_valid, utf8_codepoint_count from '../core/utf8';

define class PathSegment as
  // kind: 0 root, 1 object key, 2 array index.
  pub val int kind;
  pub val Utf8Text key;
  pub val int index;
end

define class ValidationError as
  pub val String code;
  pub val List<PathSegment> path;
  pub val String message;
  pub val int source_offset;
end

define class ValidationOptions as
  pub val bool fail_fast;
  pub val int max_errors;
end

define class ValidationReport as
  pub let List<ValidationError> errors;
  pub let bool truncated;
end

define class ValidValue as
  pub val Value value;
end

define class ParsedNumber as
  pub val bool ok;
  pub val float value;
end

define class ValueRule as
  // expected_kind < 0 means any kind.
  pub val int expected_kind;

  // Negative bounds disable the rule.
  pub val int min_length;
  pub val int max_length;
  pub val int min_items;
  pub val int max_items;

  pub val bool require_ascii;
  pub val bool require_email;
  pub val bool require_uuid;
  pub val bool require_url;
  pub val bool require_unique_items;

  pub val bool has_min_number;
  pub val float min_number;
  pub val bool min_exclusive;

  pub val bool has_max_number;
  pub val float max_number;
  pub val bool max_exclusive;
end

define class FieldRule as
  pub val Utf8Text key;
  pub val bool required;
  pub val bool forbidden;
  pub val ValueRule value_rule;
end

define class ObjectSchema as
  pub val List<FieldRule> fields;
  pub val bool reject_unknown_fields;
end

pub fnc default_validation_options(): ValidationOptions {
  return new ValidationOptions(false, 64);
}

pub fnc any_rule(): ValueRule {
  return new ValueRule(
    -1,
    -1,
    -1,
    -1,
    -1,
    false,
    false,
    false,
    false,
    false,
    false,
    0.0,
    false,
    false,
    0.0,
    false
  );
}


pub fnc kind_rule(int expected_kind): ValueRule {
  return new ValueRule(
    expected_kind,
    -1,
    -1,
    -1,
    -1,
    false,
    false,
    false,
    false,
    false,
    false,
    0.0,
    false,
    false,
    0.0,
    false
  );
}

pub fnc string_rule(
  int min_length,
  int max_length,
  bool require_ascii,
  bool require_email,
  bool require_uuid,
  bool require_url
): ValueRule {
  return new ValueRule(
    3,
    min_length,
    max_length,
    -1,
    -1,
    require_ascii,
    require_email,
    require_uuid,
    require_url,
    false,
    false,
    0.0,
    false,
    false,
    0.0,
    false
  );
}

pub fnc number_rule(
  bool has_min,
  float min_value,
  bool min_exclusive,
  bool has_max,
  float max_value,
  bool max_exclusive
): ValueRule {
  return new ValueRule(
    2,
    -1,
    -1,
    -1,
    -1,
    false,
    false,
    false,
    false,
    false,
    has_min,
    min_value,
    min_exclusive,
    has_max,
    max_value,
    max_exclusive
  );
}

pub fnc array_rule(
  int min_items,
  int max_items,
  bool unique_items
): ValueRule {
  return new ValueRule(
    5,
    -1,
    -1,
    min_items,
    max_items,
    false,
    false,
    false,
    false,
    unique_items,
    false,
    0.0,
    false,
    false,
    0.0,
    false
  );
}

pub fnc field_rule(
  Utf8Text key,
  bool required,
  bool forbidden,
  ValueRule value_rule
): FieldRule {
  return new FieldRule(key, required, forbidden, value_rule);
}

pub fnc object_schema(
  List<FieldRule> fields,
  bool reject_unknown_fields
): ObjectSchema {
  return new ObjectSchema(fields, reject_unknown_fields);
}


pub fnc validation_options_valid(ValidationOptions options): bool {
  return options.max_errors >= 0 && options.max_errors <= 4096;
}

pub fnc value_rule_valid(ValueRule rule): bool {
  if rule.expected_kind < -1 || rule.expected_kind > 8 then
    return false;
  fi

  if rule.min_length < -1 ||
     rule.max_length < -1 ||
     rule.min_items < -1 ||
     rule.max_items < -1 then
    return false;
  fi

  if rule.min_length >= 0 &&
     rule.max_length >= 0 &&
     rule.min_length > rule.max_length then
    return false;
  fi

  if rule.min_items >= 0 &&
     rule.max_items >= 0 &&
     rule.min_items > rule.max_items then
    return false;
  fi

  let bool has_length_constraint =
    rule.min_length >= 0 || rule.max_length >= 0;
  if has_length_constraint &&
     rule.expected_kind != 3 &&
     rule.expected_kind != 4 then
    return false;
  fi

  if (rule.require_ascii ||
      rule.require_email ||
      rule.require_uuid ||
      rule.require_url) &&
     rule.expected_kind != 3 then
    return false;
  fi

  if (rule.min_items >= 0 ||
      rule.max_items >= 0 ||
      rule.require_unique_items) &&
     rule.expected_kind != 5 then
    return false;
  fi

  if (rule.has_min_number || rule.has_max_number) &&
     rule.expected_kind != 2 then
    return false;
  fi

  if rule.has_min_number && rule.has_max_number then
    if rule.min_number > rule.max_number then
      return false;
    fi

    if rule.min_number == rule.max_number &&
       (rule.min_exclusive || rule.max_exclusive) then
      return false;
    fi
  fi

  return true;
}

fnc config_report(
  String code,
  String message
): ValidationReport {
  let List<ValidationError> errors = new List<ValidationError>();
  errors.push(
    new ValidationError(
      code,
      new List<PathSegment>(),
      message,
      -1
    )
  );
  return new ValidationReport(errors, false);
}

fnc object_schema_valid(ObjectSchema schema): bool {
  let Map<int, List<int>> buckets = new Map<int, List<int>>();
  let int i = 0;

  loop do
    if i >= schema.fields.length then
      break;
    fi

    let FieldRule field = schema.fields[i];

    if field.required && field.forbidden then
      return false;
    fi

    if !value_rule_valid(field.value_rule) then
      return false;
    fi

    let int hash = text_hash(field.key);
    if buckets.contains(hash) then
      let List<int> candidates = buckets.get(hash);
      for const index of candidates do
        if text_equal(schema.fields[index].key, field.key) then
          return false;
        fi
      done
      candidates.push(i);
    else
      let List<int> candidates = new List<int>();
      candidates.push(i);
      buckets.set(hash, candidates);
    fi

    i = i + 1;
  done

  return true;
}

fnc empty_key(): Utf8Text {
  return new Utf8Text(new List<int>());
}

fnc key_path(Utf8Text key): List<PathSegment> {
  let List<PathSegment> path = new List<PathSegment>();
  path.push(new PathSegment(1, key, -1));
  return path;
}

fnc index_path(int index): List<PathSegment> {
  let List<PathSegment> path = new List<PathSegment>();
  path.push(new PathSegment(2, empty_key(), index));
  return path;
}

fnc add_error(
  ValidationReport mut report,
  ValidationOptions options,
  String code,
  List<PathSegment> path,
  String message
): void {
  if options.max_errors <= 0 then
    report.truncated = true;
    return;
  fi

  if report.errors.length >= options.max_errors then
    report.truncated = true;
    return;
  fi

  report.errors.push(new ValidationError(code, path, message, -1));
  return;
}

fnc should_stop(ValidationReport report, ValidationOptions options): bool {
  if report.truncated then
    return true;
  fi
  return options.fail_fast && report.errors.length > 0;
}

pub fnc is_ascii(Utf8Text text): bool {
  for const byte of text.bytes do
    if byte < 0 || byte > 127 then
      return false;
    fi
  done
  return true;
}

fnc is_ascii_letter_or_digit(int byte): bool {
  if byte >= 48 && byte <= 57 then
    return true;
  fi
  if byte >= 65 && byte <= 90 then
    return true;
  fi
  return byte >= 97 && byte <= 122;
}

fnc is_hex(int byte): bool {
  if byte >= 48 && byte <= 57 then
    return true;
  fi
  if byte >= 65 && byte <= 70 then
    return true;
  fi
  return byte >= 97 && byte <= 102;
}

pub fnc is_uuid(Utf8Text text): bool {
  if text.bytes.length != 36 then
    return false;
  fi

  let int i = 0;
  loop do
    if i >= 36 then
      break;
    fi

    if i == 8 || i == 13 || i == 18 || i == 23 {
      if text.bytes[i] != 45 {
        return false;
      } fi
    } else {
      if !is_hex(text.bytes[i]) {
        return false;
      } fi
    } fi

    i = i + 1;
  done

  return true;
}

pub fnc is_email(Utf8Text text): bool {
  if !is_ascii(text) then
    return false;
  fi

  if text.bytes.length < 3 || text.bytes.length > 254 then
    return false;
  fi

  let int at = -1;
  let int i = 0;

  loop do
    if i >= text.bytes.length then
      break;
    fi

    let int byte = text.bytes[i];

    if byte == 64 then
      if at >= 0 then
        return false;
      fi
      at = i;
    elseif byte <= 32 || byte == 127 then
      return false;
    fi

    i = i + 1;
  done

  if at <= 0 || at >= text.bytes.length - 1 then
    return false;
  fi

  if at > 64 then
    return false;
  fi

  if text.bytes[0] == 46 || text.bytes[at - 1] == 46 then
    return false;
  fi

  // Basic local-part shape: no consecutive dots.
  i = 1;
  loop do
    if i >= at then
      break;
    fi
    if text.bytes[i] == 46 && text.bytes[i - 1] == 46 then
      return false;
    fi
    i = i + 1;
  done

  // Basic domain-name shape: at least two non-empty labels; labels use
  // letters/digits/hyphens and cannot begin/end with a hyphen.
  let bool saw_dot = false;
  let int label_start = at + 1;
  i = label_start;

  loop do
    if i > text.bytes.length then
      break;
    fi

    let bool at_end = i == text.bytes.length;
    let int byte = at_end ? 46 : text.bytes[i];

    if byte == 46 {
      if i == label_start {
        return false;
      } fi
      if text.bytes[label_start] == 45 || text.bytes[i - 1] == 45 {
        return false;
      } fi
      if !at_end {
        saw_dot = true;
      } fi
      label_start = i + 1;
    } else {
      if !is_ascii_letter_or_digit(byte) && byte != 45 {
        return false;
      } fi
    } fi

    if at_end then
      break;
    fi
    i = i + 1;
  done

  return saw_dot;
}

fnc starts_with_ascii(Utf8Text text, List<int> prefix): bool {
  if text.bytes.length < prefix.length then
    return false;
  fi

  let int i = 0;
  loop do
    if i >= prefix.length then
      break;
    fi
    if text.bytes[i] != prefix[i] then
      return false;
    fi
    i = i + 1;
  done
  return true;
}

pub fnc is_url(Utf8Text text): bool {
  if !is_ascii(text) then
    return false;
  fi

  let int host_start = -1;

  if starts_with_ascii(
    text,
    new List<int>(104, 116, 116, 112, 58, 47, 47)
  ) then
    host_start = 7;
  elseif starts_with_ascii(
    text,
    new List<int>(104, 116, 116, 112, 115, 58, 47, 47)
  ) then
    host_start = 8;
  else
    return false;
  fi

  if host_start >= text.bytes.length then
    return false;
  fi

  // The basic validator intentionally handles only absolute HTTP(S) URLs.
  // Reject whitespace/control bytes and require a non-empty authority before
  // path/query/fragment delimiters. Full RFC 3986 normalization is out of scope.
  let bool saw_authority = false;
  let int i = host_start;

  loop do
    if i >= text.bytes.length then
      break;
    fi

    let int byte = text.bytes[i];
    if byte <= 32 || byte == 127 then
      return false;
    fi

    if byte == 47 || byte == 63 || byte == 35 then
      break;
    fi

    saw_authority = true;
    i = i + 1;
  done

  return saw_authority;
}

pub fnc parse_number(Value value): ParsedNumber {
  if value.kind != 2 then
    return new ParsedNumber(false, 0.0);
  fi

  let List<int> bytes = value.number_lexeme;
  if bytes.length == 0 then
    return new ParsedNumber(false, 0.0);
  fi

  let int i = 0;
  let float sign = 1.0;

  if bytes[i] == 45 then
    sign = 0.0 - 1.0;
    i = i + 1;
  fi

  let float whole = 0.0;
  let bool saw_digit = false;

  loop do
    if i >= bytes.length then
      break;
    fi
    let int byte = bytes[i];
    if byte < 48 || byte > 57 then
      break;
    fi
    whole = (whole * 10.0) + (byte - 48);
    saw_digit = true;
    i = i + 1;
  done

  if !saw_digit then
    return new ParsedNumber(false, 0.0);
  fi

  let float fraction = 0.0;
  let float divisor = 1.0;

  if i < bytes.length && bytes[i] == 46 then
    i = i + 1;
    let bool saw_fraction = false;

    loop do
      if i >= bytes.length then
        break;
      fi
      let int byte = bytes[i];
      if byte < 48 || byte > 57 then
        break;
      fi
      fraction = (fraction * 10.0) + (byte - 48);
      divisor = divisor * 10.0;
      saw_fraction = true;
      i = i + 1;
    done

    if !saw_fraction then
      return new ParsedNumber(false, 0.0);
    fi
  fi

  let int exponent = 0;
  let int exponent_sign = 1;

  if i < bytes.length && (bytes[i] == 101 || bytes[i] == 69) then
    i = i + 1;

    if i < bytes.length && bytes[i] == 43 then
      i = i + 1;
    elseif i < bytes.length && bytes[i] == 45 then
      exponent_sign = -1;
      i = i + 1;
    fi

    let bool saw_exponent = false;
    loop do
      if i >= bytes.length then
        break;
      fi
      let int byte = bytes[i];
      if byte < 48 || byte > 57 then
        return new ParsedNumber(false, 0.0);
      fi
      exponent = (exponent * 10) + (byte - 48);
      if exponent > 308 then
        return new ParsedNumber(false, 0.0);
      fi
      saw_exponent = true;
      i = i + 1;
    done

    if !saw_exponent then
      return new ParsedNumber(false, 0.0);
    fi
  fi

  if i != bytes.length then
    return new ParsedNumber(false, 0.0);
  fi

  let float result = sign * (whole + (fraction / divisor));
  let int steps = exponent;
  let int j = 0;

  loop do
    if j >= steps then
      break;
    fi
    if exponent_sign > 0 then
      result = result * 10.0;
    else
      result = result / 10.0;
    fi
    j = j + 1;
  done

  return new ParsedNumber(true, result);
}

fnc validate_unique(
  Value value,
  ValidationReport mut report,
  ValidationOptions options,
  List<PathSegment> path
): void {
  let Map<int, List<Value>> buckets = new Map<int, List<Value>>();

  for const item of value.array_value do
    let int hash = value_hash(item);

    if buckets.contains(hash) then
      let List<Value> candidates = buckets.get(hash);
      for const candidate of candidates do
        if value_deep_equal(candidate, item) then
          add_error(
            report,
            options,
            "unique_items",
            path,
            "array contains duplicate values"
          );
          return;
        fi
      done
      candidates.push(item);
    else
      let List<Value> candidates = new List<Value>();
      candidates.push(item);
      buckets.set(hash, candidates);
    fi
  done

  return;
}

fnc validate_rule_at(
  Value value,
  ValueRule rule,
  ValidationReport mut report,
  ValidationOptions options,
  List<PathSegment> path
): void {
  if rule.expected_kind >= 0 && value.kind != rule.expected_kind then
    add_error(report, options, "type", path, "value has the wrong wire type");
    return;
  fi

  if should_stop(report, options) then
    return;
  fi

  if value.kind == 3 then
    if !utf8_is_valid(value.string_value.bytes) then
      add_error(report, options, "utf8", path, "string contains invalid UTF-8");
      return;
    fi

    let int length = utf8_codepoint_count(value.string_value.bytes);

    if rule.min_length >= 0 && length < rule.min_length then
      add_error(report, options, "min_length", path, "string is shorter than min_length");
    fi
    if should_stop(report, options) then
      return;
    fi

    if rule.max_length >= 0 && length > rule.max_length then
      add_error(report, options, "max_length", path, "string is longer than max_length");
    fi
    if should_stop(report, options) then
      return;
    fi

    if rule.require_ascii && !is_ascii(value.string_value) then
      add_error(report, options, "ascii", path, "string must contain only ASCII");
    fi
    if should_stop(report, options) then
      return;
    fi

    if rule.require_email && !is_email(value.string_value) then
      add_error(report, options, "email", path, "string is not a valid basic email address");
    fi
    if should_stop(report, options) then
      return;
    fi

    if rule.require_uuid && !is_uuid(value.string_value) then
      add_error(report, options, "uuid", path, "string is not a canonical UUID");
    fi
    if should_stop(report, options) then
      return;
    fi

    if rule.require_url && !is_url(value.string_value) then
      add_error(report, options, "url", path, "string is not an http/https URL");
    fi
  fi

  if value.kind == 4 then
    if rule.min_length >= 0 && value.bytes_value.length < rule.min_length then
      add_error(report, options, "min_length", path, "byte string is shorter than min_length");
    fi
    if should_stop(report, options) then
      return;
    fi
    if rule.max_length >= 0 && value.bytes_value.length > rule.max_length then
      add_error(report, options, "max_length", path, "byte string is longer than max_length");
    fi
  fi

  if value.kind == 5 then
    if rule.min_items >= 0 && value.array_value.length < rule.min_items then
      add_error(report, options, "min_items", path, "array contains too few items");
    fi
    if should_stop(report, options) then
      return;
    fi

    if rule.max_items >= 0 && value.array_value.length > rule.max_items then
      add_error(report, options, "max_items", path, "array contains too many items");
    fi
    if should_stop(report, options) then
      return;
    fi

    if rule.require_unique_items then
      validate_unique(value, report, options, path);
    fi
  fi

  if value.kind == 2 && (rule.has_min_number || rule.has_max_number) then
    let ParsedNumber parsed = parse_number(value);
    if !parsed.ok then
      add_error(report, options, "number", path, "number cannot be represented for range validation");
      return;
    fi

    if rule.has_min_number {
      if rule.min_exclusive {
        if parsed.value <= rule.min_number {
          add_error(report, options, "exclusive_min", path, "number must be greater than the minimum");
        } fi
      } else {
        if parsed.value < rule.min_number {
          add_error(report, options, "min", path, "number is below the minimum");
        } fi
      } fi
    } fi

    if should_stop(report, options) then
      return;
    fi

    if rule.has_max_number {
      if rule.max_exclusive {
        if parsed.value >= rule.max_number {
          add_error(report, options, "exclusive_max", path, "number must be less than the maximum");
        } fi
      } else {
        if parsed.value > rule.max_number {
          add_error(report, options, "max", path, "number is above the maximum");
        } fi
      } fi
    } fi
  fi

  return;
}

pub fnc validate_value(
  Value value,
  ValueRule rule,
  ValidationOptions options
): ValidationReport {
  if !validation_options_valid(options) then
    return config_report(
      "invalid_options",
      "validation options are outside supported bounds"
    );
  fi

  if !value_rule_valid(rule) then
    return config_report(
      "invalid_rule",
      "validation rule is contradictory or incompatible with its value kind"
    );
  fi

  let ValidationReport report = new ValidationReport(
    new List<ValidationError>(),
    false
  );
  validate_rule_at(value, rule, report, options, new List<PathSegment>());
  return report;
}

fnc schema_field_index(ObjectSchema schema, Utf8Text key): int {
  let int i = 0;
  for const field of schema.fields do
    if text_equal(field.key, key) then
      return i;
    fi
    i = i + 1;
  done
  return -1;
}

pub fnc validate_object(
  Value value,
  ObjectSchema schema,
  ValidationOptions options
): ValidationReport {
  if !validation_options_valid(options) then
    return config_report(
      "invalid_options",
      "validation options are outside supported bounds"
    );
  fi

  if !object_schema_valid(schema) then
    return config_report(
      "invalid_schema",
      "object schema contains duplicate, contradictory, or invalid field rules"
    );
  fi

  let ValidationReport report = new ValidationReport(
    new List<ValidationError>(),
    false
  );

  if value.kind != 6 then
    add_error(
      report,
      options,
      "type",
      new List<PathSegment>(),
      "object schema requires an object/map value"
    );
    return report;
  fi

  for const field of schema.fields do
    let int index = object_find_index(value, field.key);

    if index < 0 then
      if field.required then
        add_error(
          report,
          options,
          "required",
          key_path(field.key),
          "required field is missing"
        );
      fi

      if should_stop(report, options) then
        return report;
      fi
      continue;
    fi

    if field.forbidden then
      add_error(
        report,
        options,
        "forbidden",
        key_path(field.key),
        "field is forbidden"
      );
      if should_stop(report, options) then
        return report;
      fi
      continue;
    fi

    validate_rule_at(
      value.object_value[index].value,
      field.value_rule,
      report,
      options,
      key_path(field.key)
    );

    if should_stop(report, options) then
      return report;
    fi
  done

  if schema.reject_unknown_fields then
    for const member of value.object_value do
      if schema_field_index(schema, member.key) < 0 then
        add_error(
          report,
          options,
          "unknown_field",
          key_path(member.key),
          "unknown field is not allowed"
        );
        if should_stop(report, options) then
          return report;
        fi
      fi
    done
  fi

  return report;
}

pub fnc report_is_valid(ValidationReport report): bool {
  return report.errors.length == 0 && !report.truncated;
}


pub fnc validate_value_checked(
  Value value,
  ValueRule rule,
  ValidationOptions options
): Result<ValidValue, ValidationReport> {
  let ValidationReport report = validate_value(value, rule, options);
  if report_is_valid(report) then
    return Ok(new ValidValue(value));
  fi
  return Err(report);
}

pub fnc validate_object_checked(
  Value value,
  ObjectSchema schema,
  ValidationOptions options
): Result<ValidValue, ValidationReport> {
  let ValidationReport report = validate_object(value, schema, options);
  if report_is_valid(report) then
    return Ok(new ValidValue(value));
  fi
  return Err(report);
}
