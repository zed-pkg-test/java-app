import fnc require_true, require_int from './assert';

import class Value, Utf8Text, WireMember from '../src/core/value';
import fnc value_int, value_bool, value_string, value_array, value_object, value_deep_equal from '../src/core/value';
import class DecodeOptions, DecodeError, EncodeError, DecodedValue from '../src/core/options';
import fnc default_decode_options, default_encode_options from '../src/core/options';
import fnc encode, decode from '../src/messagepack/messagepack';

pub fnc run_messagepack_tests(): void {
  let List<Value> values = new List<Value>();
  values.push(value_int(7));
  values.push(value_bool(true));

  let List<WireMember> members = new List<WireMember>();
  members.push(
    new WireMember(
      new Utf8Text(new List<int>(120)),
      value_array(values)
    )
  );

  val Value source = value_object(members);

  val Result<List<int>, EncodeError> encoded = encode(
    source,
    default_encode_options()
  );
  require_true(encoded.is_err() == false, "MessagePack object must encode");

  val Result<DecodedValue, DecodeError> decoded = decode(
    encoded.unwrap(),
    default_decode_options()
  );
  require_true(decoded.is_err() == false, "MessagePack object must decode");
  require_true(
    value_deep_equal(source, decoded.unwrap().value),
    "MessagePack dynamic value must round-trip"
  );

  // [1, 2, 3] using fixarray/fixints.
  val Result<DecodedValue, DecodeError> fixed = decode(
    new List<int>(147, 1, 2, 3),
    default_decode_options()
  );
  require_true(fixed.is_err() == false, "MessagePack fixarray should decode");
  require_int(fixed.unwrap().value.array_value.length, 3, "MessagePack fixarray length");

  // { 1: 2 } is a general MessagePack map, not a JSON-shaped object.
  val Result<DecodedValue, DecodeError> general_map = decode(
    new List<int>(129, 1, 2),
    default_decode_options()
  );
  require_true(general_map.is_err() == false, "MessagePack integer-key map must decode");
  require_int(general_map.unwrap().value.kind, 8, "integer-key MessagePack map kind");
  require_int(general_map.unwrap().value.map_value.length, 1, "integer-key MessagePack map size");

  val Result<List<int>, EncodeError> general_map_encoded = encode(
    general_map.unwrap().value,
    default_encode_options()
  );
  require_true(general_map_encoded.is_err() == false, "MessagePack general map must re-encode");
  require_int(general_map_encoded.unwrap()[0], 129, "MessagePack general map header");

  val int min_int = -9223372036854775807 - 1;
  val int max_int = 9223372036854775807;

  val Result<List<int>, EncodeError> min_encoded = encode(
    value_int(min_int),
    default_encode_options()
  );
  require_true(min_encoded.is_err() == false, "MessagePack int64 minimum must encode");

  val Result<DecodedValue, DecodeError> min_decoded = decode(
    min_encoded.unwrap(),
    default_decode_options()
  );
  require_true(min_decoded.is_err() == false, "MessagePack int64 minimum must decode");
  require_true(
    value_deep_equal(value_int(min_int), min_decoded.unwrap().value),
    "MessagePack int64 minimum must round-trip"
  );

  val Result<List<int>, EncodeError> max_encoded = encode(
    value_int(max_int),
    default_encode_options()
  );
  require_true(max_encoded.is_err() == false, "MessagePack int64 maximum must encode");

  val Result<DecodedValue, DecodeError> max_decoded = decode(
    max_encoded.unwrap(),
    default_decode_options()
  );
  require_true(max_decoded.is_err() == false, "MessagePack int64 maximum must decode");
  require_true(
    value_deep_equal(value_int(max_int), max_decoded.unwrap().value),
    "MessagePack int64 maximum must round-trip"
  );

  val Result<DecodedValue, DecodeError> truncated = decode(
    new List<int>(217, 2, 97),
    default_decode_options()
  );
  require_true(truncated.is_err(), "MessagePack truncated str8 must reject");

  val Result<DecodedValue, DecodeError> declared_length_bomb = decode(
    new List<int>(219, 255, 255, 255, 255),
    default_decode_options()
  );
  require_true(
    declared_length_bomb.is_err(),
    "MessagePack huge declared string length must reject before allocation"
  );

  val DecodeOptions tiny_input = new DecodeOptions(
    0, false, 128, 1, 16, 16, 16, 16, 16
  );
  val Result<DecodedValue, DecodeError> input_limited = decode(
    new List<int>(146, 1, 2),
    tiny_input
  );
  require_true(input_limited.is_err(), "MessagePack max_input_bytes must fail closed");

  return;
}
