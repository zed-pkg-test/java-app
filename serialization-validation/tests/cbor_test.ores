import fnc require_true, require_int from './assert';

import class Value, Utf8Text, WireMember from '../src/core/value';
import fnc value_int, value_string, value_object, value_deep_equal from '../src/core/value';
import class DecodeOptions, DecodeError, EncodeError, DecodedValue from '../src/core/options';
import fnc default_decode_options, default_encode_options from '../src/core/options';
import fnc encode, decode from '../src/cbor/cbor';

pub fnc run_cbor_tests(): void {
  let List<WireMember> members = new List<WireMember>();
  members.push(
    new WireMember(
      new Utf8Text(new List<int>(110)),
      value_int(-17)
    )
  );
  members.push(
    new WireMember(
      new Utf8Text(new List<int>(115)),
      value_string(new Utf8Text(new List<int>(111, 107)))
    )
  );

  val Value source = value_object(members);

  val Result<List<int>, EncodeError> encoded = encode(
    source,
    default_encode_options()
  );
  require_true(encoded.is_err() == false, "CBOR object must encode");

  val Result<DecodedValue, DecodeError> decoded = decode(
    encoded.unwrap(),
    default_decode_options()
  );
  require_true(decoded.is_err() == false, "CBOR object must decode");
  require_true(
    value_deep_equal(source, decoded.unwrap().value),
    "CBOR dynamic value must round-trip"
  );

  // 0x18 0x2a = unsigned integer 42.
  val Result<DecodedValue, DecodeError> forty_two = decode(
    new List<int>(24, 42),
    default_decode_options()
  );
  require_true(forty_two.is_err() == false, "CBOR uint8 argument should decode");
  require_int(forty_two.unwrap().value.kind, 2, "CBOR integer kind");

  // { 1: 2 } is a general CBOR map, not a JSON-shaped object.
  val Result<DecodedValue, DecodeError> general_map = decode(
    new List<int>(161, 1, 2),
    default_decode_options()
  );
  require_true(general_map.is_err() == false, "CBOR integer-key map must decode");
  require_int(general_map.unwrap().value.kind, 8, "integer-key CBOR map kind");
  require_int(general_map.unwrap().value.map_value.length, 1, "integer-key CBOR map size");

  val Result<List<int>, EncodeError> general_map_encoded = encode(
    general_map.unwrap().value,
    default_encode_options()
  );
  require_true(general_map_encoded.is_err() == false, "CBOR general map must re-encode");
  require_int(general_map_encoded.unwrap()[0], 161, "CBOR general map header");

  val int min_int = -9223372036854775807 - 1;
  val int max_int = 9223372036854775807;

  val Result<List<int>, EncodeError> min_encoded = encode(
    value_int(min_int),
    default_encode_options()
  );
  require_true(min_encoded.is_err() == false, "CBOR int64 minimum must encode");
  val Result<DecodedValue, DecodeError> min_decoded = decode(
    min_encoded.unwrap(),
    default_decode_options()
  );
  require_true(min_decoded.is_err() == false, "CBOR int64 minimum must decode");
  require_true(
    value_deep_equal(value_int(min_int), min_decoded.unwrap().value),
    "CBOR int64 minimum must round-trip"
  );

  val Result<List<int>, EncodeError> max_encoded = encode(
    value_int(max_int),
    default_encode_options()
  );
  require_true(max_encoded.is_err() == false, "CBOR int64 maximum must encode");
  val Result<DecodedValue, DecodeError> max_decoded = decode(
    max_encoded.unwrap(),
    default_decode_options()
  );
  require_true(max_decoded.is_err() == false, "CBOR int64 maximum must decode");
  require_true(
    value_deep_equal(value_int(max_int), max_decoded.unwrap().value),
    "CBOR int64 maximum must round-trip"
  );

  val Result<DecodedValue, DecodeError> truncated = decode(
    new List<int>(121, 0, 2, 97),
    default_decode_options()
  );
  require_true(truncated.is_err(), "CBOR truncated text must reject");

  val Result<DecodedValue, DecodeError> declared_length_bomb = decode(
    new List<int>(122, 255, 255, 255, 255),
    default_decode_options()
  );
  require_true(
    declared_length_bomb.is_err(),
    "CBOR huge declared text length must reject before allocation"
  );

  val Result<DecodedValue, DecodeError> indefinite = decode(
    new List<int>(159),
    default_decode_options()
  );
  require_true(indefinite.is_err(), "CBOR indefinite-length baseline must fail closed");

  val DecodeOptions tiny_input = new DecodeOptions(
    0, false, 128, 1, 16, 16, 16, 16, 16
  );
  val Result<DecodedValue, DecodeError> input_limited = decode(
    new List<int>(24, 42),
    tiny_input
  );
  require_true(input_limited.is_err(), "CBOR max_input_bytes must fail closed");

  return;
}
