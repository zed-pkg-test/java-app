import fnc require_true, require_int from './assert';

import class DecodeError, DecodedValue from '../src/core/options';
import fnc default_decode_options from '../src/core/options';
import fnc decode_one_from_channel from '../src/json/channel';

pub async fnc run_json_channel_tests(): void {
  val Channel<Option<List<int>>> input = Channel.new<Option<List<int>>>(3);

  // Split a UTF-8 code point across chunks: JSON string "é".
  writech input, Some(new List<int>(34, 195));
  writech input, Some(new List<int>(169, 34));
  val Option<List<int>> eof = None;
  writech input, eof;

  val Result<DecodedValue, DecodeError> decoded =
    await decode_one_from_channel(input, default_decode_options());

  require_true(decoded.is_err() == false, "channel JSON should decode");
  require_int(decoded.unwrap().value.kind, 3, "channel JSON string kind");
  require_int(decoded.unwrap().value.string_value.bytes.length, 2, "UTF-8 byte length");
  require_int(decoded.unwrap().value.string_value.bytes[0], 195, "UTF-8 first byte");
  require_int(decoded.unwrap().value.string_value.bytes[1], 169, "UTF-8 second byte");

  val Channel<Option<List<int>>> truncated = Channel.new<Option<List<int>>>(2);
  writech truncated, Some(new List<int>(123, 34, 120, 34, 58));
  val Option<List<int>> truncated_eof = None;
  writech truncated, truncated_eof;

  val Result<DecodedValue, DecodeError> failed =
    await decode_one_from_channel(truncated, default_decode_options());
  require_true(failed.is_err(), "EOF must reject truncated channel JSON");

  return;
}
