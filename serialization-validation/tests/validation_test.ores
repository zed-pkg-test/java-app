import fnc require_true, require_int from './assert';

import class Value, Utf8Text, WireMember, MapEntry from '../src/core/value';
import fnc value_int, value_string, value_array, value_object, value_map, value_deep_equal from '../src/core/value';
import class ValidationOptions, ValidationReport, ValueRule, FieldRule, ObjectSchema from '../src/validation/validation';
import class DecodeOptions from '../src/core/options';
import fnc default_decode_options from '../src/core/options';
import class JsonPayloadError, ValidatedDecodedValue from '../src/json/validated';
import fnc decode_and_validate_object from '../src/json/validated';
import fnc default_validation_options, string_rule, number_rule, array_rule, field_rule, object_schema from '../src/validation/validation';
import fnc validate_value, validate_object, report_is_valid, is_uuid, is_email from '../src/validation/validation';

pub fnc run_validation_tests(): void {
  val Utf8Text username_key = new Utf8Text(
    new List<int>(117, 115, 101, 114, 110, 97, 109, 101)
  );
  val Utf8Text age_key = new Utf8Text(
    new List<int>(97, 103, 101)
  );

  let List<WireMember> members = new List<WireMember>();
  members.push(
    new WireMember(
      username_key,
      value_string(new Utf8Text(new List<int>(97, 98)))
    )
  );
  members.push(new WireMember(age_key, value_int(151)));

  let List<FieldRule> fields = new List<FieldRule>();
  fields.push(
    field_rule(
      username_key,
      true,
      false,
      string_rule(3, 64, false, false, false, false)
    )
  );
  fields.push(
    field_rule(
      age_key,
      true,
      false,
      number_rule(true, 0.0, false, true, 150.0, false)
    )
  );

  val ObjectSchema schema = object_schema(fields, true);

  val List<int> valid_json = new List<int>(
    123,
    34, 117, 115, 101, 114, 110, 97, 109, 101, 34,
    58,
    34, 97, 98, 99, 100, 34,
    44,
    34, 97, 103, 101, 34,
    58,
    51, 48,
    125
  );

  val Result<ValidatedDecodedValue, JsonPayloadError> checked_json =
    decode_and_validate_object(
      valid_json,
      default_decode_options(),
      schema,
      default_validation_options()
    );
  require_true(
    checked_json.is_err() == false,
    "valid JSON payload must cross decode+validation boundary"
  );
  val ValidationReport invalid = validate_object(
    value_object(members),
    schema,
    default_validation_options()
  );

  require_true(!report_is_valid(invalid), "invalid object must fail validation");
  require_int(invalid.errors.length, 2, "validation must collect both field errors");

  require_true(
    is_uuid(
      new Utf8Text(
        new List<int>(
          53, 53, 48, 101, 56, 52, 48, 48,
          45,
          101, 50, 57, 98,
          45,
          52, 49, 100, 52,
          45,
          97, 55, 49, 54,
          45,
          52, 52, 54, 54, 53, 53, 52, 52, 48, 48, 48, 48
        )
      )
    ),
    "canonical UUID must validate"
  );

  // Object equality is member-order independent.
  let List<WireMember> object_a_members = new List<WireMember>();
  object_a_members.push(
    new WireMember(
      new Utf8Text(new List<int>(97)),
      value_int(1)
    )
  );
  object_a_members.push(
    new WireMember(
      new Utf8Text(new List<int>(98)),
      value_int(2)
    )
  );

  let List<WireMember> object_b_members = new List<WireMember>();
  object_b_members.push(
    new WireMember(
      new Utf8Text(new List<int>(98)),
      value_int(2)
    )
  );
  object_b_members.push(
    new WireMember(
      new Utf8Text(new List<int>(97)),
      value_int(1)
    )
  );

  val Value object_a = value_object(object_a_members);
  val Value object_b = value_object(object_b_members);
  require_true(
    value_deep_equal(object_a, object_b),
    "object equality must ignore member order"
  );

  // General map equality is entry-order independent too.
  let List<MapEntry> map_a_entries = new List<MapEntry>();
  map_a_entries.push(new MapEntry(value_int(1), value_int(10)));
  map_a_entries.push(new MapEntry(value_int(2), value_int(20)));

  let List<MapEntry> map_b_entries = new List<MapEntry>();
  map_b_entries.push(new MapEntry(value_int(2), value_int(20)));
  map_b_entries.push(new MapEntry(value_int(1), value_int(10)));

  require_true(
    value_deep_equal(value_map(map_a_entries), value_map(map_b_entries)),
    "general map equality must ignore entry order"
  );

  // JSON-Schema-style uniqueItems must reject reordered-equivalent objects.
  let List<Value> duplicate_objects = new List<Value>();
  duplicate_objects.push(object_a);
  duplicate_objects.push(object_b);

  val ValidationReport unique_report = validate_value(
    value_array(duplicate_objects),
    array_rule(-1, -1, true),
    default_validation_options()
  );
  require_true(
    !report_is_valid(unique_report),
    "unique_items must reject reordered-equivalent objects"
  );

  require_true(
    is_email(
      new Utf8Text(
        new List<int>(
          97, 64, 98, 46, 99, 111, 109
        )
      )
    ),
    "basic email must validate"
  );

  return;
}
