fnc fnc_down(int n): int {
  if n == 0; do
    return 0;
  else
    return fnc_down(n - 1);
  fi
}

routine routine_down(int n): int {
  if n == 0; do
    return 0;
  else
    return routine_down(n - 1);
  fi
}

pub routine main(): void {
  stdio.stdout.write(fnc_down(50000));
  stdio.stdout.write("|");
  stdio.stdout.write(routine_down(50000));
  return;
}
