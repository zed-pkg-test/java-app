pub actor fnc shared_double(int value) => int {
  return value * 2;
}

pub isoactor fnc private_add_one(int value) => int {
  return value + 1;
}

pub routine main() => void {
  val shared_pending = spawn shared_double(21);
  val private_pending = spawn private_add_one(41);

  val shared_answer = await shared_pending.result;
  val private_answer = await private_pending.result;

  stdio.println(shared_answer);
  stdio.println(private_answer);
  return;
}
