import fnc {actor_label} from "./actor-isolation-support.ores";

define class CounterState as
  pub let int value = 10;
end

// SHARED actor:
// - owns and mutates only mailbox-confined state such as local_count
// - cannot capture or mutate external shared variables
// - may receive an explicit RwLock<T> capability and acquire only its read side
shared actor SharedCounter {
  let int local_count = 0;

  pub receive_message(RwLock<CounterState> external_state) => void {
    self.local_count = self.local_count + 1;

    // Actor carriers must never park waiting for external synchronization.
    // try_read_lock() is immediate. read_lock() is also fail-fast with
    // WouldBlock while running on an Ores actor/scheduler carrier.
    val maybe_reader = external_state.try_read_lock();

    if maybe_reader.is_none(); do
      return;
    fi

    val reader = maybe_reader.unwrap();

    // CounterState is composite, so reader.value() is a lexical immutable
    // view. Use it inline; it cannot be bound, returned, mutated, or carried
    // across await.
    stdio.println(reader.value().value);

    reader.release();
    return;
  }

  private local_value() => int {
    return self.local_count;
  }

  private actor_kind() => String {
    return actor_label(true);
  }
}

// PRIVATE / isolated actor:
// - "isoactor" explicitly means private / isolated
// - owns its mutable state exclusively
// - receives a private actor memory slice at runtime
// - cannot receive RwLock<T>, SharedMutex<T>, or SyncCell shared-memory handles
isoactor PrivateCounter {
  let int value = 10;

  pub fnc increment() => void {
    self.value = self.value + 1;
    return;
  }

  pub fnc current() => int {
    return self.value;
  }

  pub fnc actor_kind() => String {
    return actor_label(false);
  }
}

/*
 * External mutable state is owned by ordinary/root scheduler code.
 *
 * Root code may create:
 *
 *   val external = RwLock.new(new CounterState());
 *
 * and may acquire external.write_lock() / try_write_lock() to publish updates.
 * A SHARED actor can receive that RwLock capability through its mailbox, but
 * only read_lock() / try_read_lock() are legal from actor code.
 *
 * Intentionally ILLEGAL Oreslang:
 *
 * shared actor BrokenSharedCounter {
 *   pub receive_message(RwLock<CounterState> external) => void {
 *     val writer = external.write_lock(); // rejected: actor external write
 *     writer.replace(new CounterState());
 *     writer.release();
 *     return;
 *   }
 * }
 *
 * isoactor BrokenPrivateCounter {
 *   pub fnc inspect(RwLock<CounterState> external) => void {
 *     return; // rejected at the actor boundary: no shared-memory capability
 *   }
 * }
 *
 * SharedMutex<T> and legacy SyncCell<T> are not alternate escape hatches for
 * actor mutation. Actor writes remain confined to actor-owned state/mailbox
 * response channels.
 */
