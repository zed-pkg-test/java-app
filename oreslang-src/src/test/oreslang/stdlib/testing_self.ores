import module testing from "std/testing";

fnc check_expectations(): testing.TestOutcome {
  val testing.TestOutcome a = testing.expect_true(true, "true must pass");
  if !a.passed; do return a; fi

  val testing.TestOutcome b = testing.expect_false(false, "false must pass");
  if !b.passed; do return b; fi

  val testing.TestOutcome c = testing.expect_equal_int(7, 7, "int equality");
  if !c.passed; do return c; fi

  val testing.TestOutcome d = testing.expect_equal_string("ores", "ores", "string equality");
  if !d.passed; do return d; fi

  return testing.expect_near_float(1.001, 1.0, 0.01, "float tolerance");
}

fnc property_non_negative(int value): testing.TestOutcome {
  return testing.expect_true(value >= 0, "fixture values must be non-negative");
}

fnc check_properties(): testing.TestOutcome {
  return testing.check_int_cases(
    "non-negative",
    arr[0, 1, 2, 10, 100],
    property_non_negative
  );
}

pub routine main(): void {
  val testing.TestSuite suite = new testing.TestSuite(
    "std/testing",
    arr[
      new testing.TestCase("expectations", check_expectations, false, ""),
      new testing.TestCase("deterministic-property", check_properties, false, ""),
      new testing.TestCase("documented-skip", check_expectations, true, "harness skip accounting")
    ]
  );

  val testing.TestOptions options = new testing.TestOptions("", false, true);
  val testing.RunSummary summary = testing.run_suite(&suite, &options);
  testing.require_success(&summary);
  return;
}
