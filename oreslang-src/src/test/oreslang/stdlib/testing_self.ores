import class {TestOutcome, TestCase, TestSuite, TestOptions, RunSummary} from "std/testing";
import fnc {pass, fail, expect_true, expect_false, expect_equal_int, expect_equal_string, expect_near_float, check_int_cases, run_suite, require_success} from "std/testing";

fnc check_expectations(): TestOutcome {
  val TestOutcome a = expect_true(true, "true must pass");
  if !a.passed; do return a; fi

  val TestOutcome b = expect_false(false, "false must pass");
  if !b.passed; do return b; fi

  val TestOutcome c = expect_equal_int(7, 7, "int equality");
  if !c.passed; do return c; fi

  val TestOutcome d = expect_equal_string("ores", "ores", "string equality");
  if !d.passed; do return d; fi

  return expect_near_float(1.001, 1.0, 0.01, "float tolerance");
}

fnc property_non_negative(int value): TestOutcome {
  return expect_true(value >= 0, "fixture values must be non-negative");
}

fnc check_properties(): TestOutcome {
  return check_int_cases(
    "non-negative",
    arr[0, 1, 2, 10, 100],
    property_non_negative
  );
}

pub routine main(): void {
  val TestSuite suite = new TestSuite(
    "std/testing",
    arr[
      new TestCase("expectations", check_expectations, false, ""),
      new TestCase("deterministic-property", check_properties, false, ""),
      new TestCase("documented-skip", check_expectations, true, "harness skip accounting")
    ]
  );

  val TestOptions options = new TestOptions("", false, true);
  val RunSummary summary = run_suite(&suite, &options);
  require_success(&summary);
  return;
}
