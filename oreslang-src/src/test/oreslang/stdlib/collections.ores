import class {TestOutcome, TestCase, TestSuite, TestOptions, RunSummary} from "std/testing";
import fnc {pass, fail, run_suite, require_success} from "std/testing";
import module collections from "std/collections";

fnc twice(int value): int {
  return value * 2;
}

fnc is_even(int value): bool {
  return value % 2 == 0;
}

fnc add_ints(int total, int value): int {
  return total + value;
}

fnc add_float(float total, int value): float {
  return total + value;
}

fnc list_functional_contract(): TestOutcome {
  let collections.List<int> values = new collections.List<int>();
  values.add(1);
  values.add(2);
  values.add(3);

  val collections.List<int> mapped = values.map(twice);
  val collections.List<int> filtered = values.filter(is_even);

  if values.size() != 3; do
    return fail("map/filter must not mutate List source");
  fi
  if mapped.size() != 3 || mapped.get(2) != 6; do
    return fail("List.map must preserve List family and map every element");
  fi
  if filtered.size() != 1 || filtered.get(0) != 2; do
    return fail("List.filter must preserve List family");
  fi
  if values.reduce(0, add_ints) != 6; do
    return fail("seeded List.reduce returned wrong value");
  fi
  if values.reduce(add_ints).unwrap() != 6; do
    return fail("unseeded List.reduce returned wrong value");
  fi
  return pass();
}

fnc family_and_generic_contract(): TestOutcome {
  let collections.ArrayList<int> array_list = new collections.ArrayList<int>();
  array_list.add(4);
  array_list.add(5);
  val collections.ArrayList<int> mapped_array = array_list.map(twice);
  if mapped_array.get(1) != 10; do
    return fail("ArrayList.map must preserve ArrayList family");
  fi
  if array_list.reduce(0.5, add_float) != 9.5; do
    return fail("ArrayList.reduce must support independent accumulator type");
  fi

  let collections.Vector<int> vector = new collections.Vector<int>();
  vector.add(6);
  vector.add(7);
  val collections.Vector<bool> mapped_vector = vector.map(is_even);
  if mapped_vector.get(0) != true || mapped_vector.get(1) != false; do
    return fail("Vector.map must permit element type transformation");
  fi

  let collections.Vector<int> empty = new collections.Vector<int>();
  if !empty.reduce(add_ints).is_none(); do
    return fail("unseeded reduce on empty sequence must return None");
  fi
  return pass();
}

fnc iterator_snapshot_contract(): TestOutcome {
  let collections.List<int> values = new collections.List<int>();
  values.add(10);
  values.add(20);
  values.add(30);

  // for-of obtains Symbol.iterator once. SequenceCore deliberately returns an
  // Array snapshot so an rx-ores from_iterable subscription can pull a stable
  // view even if explicit mutable authority changes the source afterward.
  let int seen = 0;
  let int sum = 0;
  for value of values do
    seen = seen + 1;
    sum = sum + value;
    if seen == 1; do
      values.add(40);
    fi
  done

  if seen != 3 || sum != 60; do
    return fail("collection iterator must be a stable per-iteration snapshot");
  fi
  if values.size() != 4; do
    return fail("explicit source mutation should remain visible outside iterator snapshot");
  fi
  return pass();
}

fnc independent_iterators_contract(): TestOutcome {
  let Vector<int> values = new collections.Vector<int>();
  values.add(1);
  values.add(2);

  let int first_count = 0;
  for value of values do
    first_count = first_count + 1;
  done

  let int second_count = 0;
  for value of values do
    second_count = second_count + 1;
  done

  if first_count != 2 || second_count != 2; do
    return fail("cold iterable consumers must obtain independent iterators");
  fi
  return pass();
}

pub routine main(): void {
  val TestSuite suite = new TestSuite(
    "std/collections",
    arr[
      new TestCase("functional-list", list_functional_contract, false, ""),
      new TestCase("families-and-generics", family_and_generic_contract, false, ""),
      new TestCase("iterator-snapshot-rx-boundary", iterator_snapshot_contract, false, ""),
      new TestCase("independent-iterators", independent_iterators_contract, false, "")
    ]
  );

  val TestOptions options = new TestOptions("", false, true);
  val RunSummary summary = run_suite(&suite, &options);
  require_success(&summary);
  return;
}
