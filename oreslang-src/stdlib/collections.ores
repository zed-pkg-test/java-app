// Oreslang-owned collection semantics.
//
// Array<T> remains a VM/native storage primitive. Public collection behavior
// belongs in Oreslang so API semantics are identical across JIT/AOT/hybrid
// execution and do not depend on java.util collection implementations.

define module collections

  // Shared implementation for the growable sequence families. Storage is the
  // native Array<T> primitive; algorithms and API behavior are Oreslang.
  define class SequenceCore<T> as
    let Array<T> items = new Array<T>();

    pub size(): int {
      return self.items.size;
    }

    pub is_empty(): bool {
      return self.items.size == 0;
    }

    pub get(int index): T {
      return self.items.get(index);
    }

    pub set(int index, T value): T {
      return self.items.set(index, value);
    }

    pub add(T value): void {
      self.items.add(value);
      return;
    }

    pub push(T value): void {
      self.items.add(value);
      return;
    }

    pub pop(): Option<T> {
      if self.items.size == 0; do
        return None;
      fi
      return Some(self.items.remove(self.items.size - 1));
    }

    pub first(): Option<T> {
      if self.items.size == 0; do
        return None;
      fi
      return Some(self.items.get(0));
    }

    pub last(): Option<T> {
      if self.items.size == 0; do
        return None;
      fi
      return Some(self.items.get(self.items.size - 1));
    }

    pub remove_at(int index): T {
      return self.items.remove(index);
    }

    pub contains(T value): bool {
      for item of self.items do
        if item == value; do
          return true;
        fi
      done
      return false;
    }

    pub index_of(T value): int {
      let int index = 0;
      for item of self.items do
        if item == value; do
          return index;
        fi
        index = index + 1;
      done
      return -1;
    }

    pub clear(): void {
      self.items.clear();
      return;
    }

    // Eager functional operators use ordinary Oreslang Fnc values and the
    // iterable contract. They intentionally have no dependency on rx-ores;
    // reactive adapters can consume/produce these collections through
    // [Symbol.iterator]() without the core collection layer knowing about Rx.
    pub reduce(Fnc<T, T, T> reducer): Option<T> {
      if self.items.size == 0; do
        return None;
      fi

      let T accumulator = self.items.get(0);
      for (let int index = 1; index < self.items.size; index = index + 1) {
        accumulator = reducer(accumulator, self.items.get(index));
      }
      return Some(accumulator);
    }

    pub reduce<U>(U initial, Fnc<U, T, U> reducer): U {
      let U accumulator = initial;
      for item of self.items do
        accumulator = reducer(accumulator, item);
      done
      return accumulator;
    }

    pub to_array(): Array<T> {
      let Array<T> copy = new Array<T>();
      for item of self.items do
        copy.add(item);
      done
      return copy;
    }

    // Snapshot iteration is part of the core collection contract. Consumers
    // such as rx-ores obtain an independent iterable view per subscription;
    // later explicit mutation of this collection cannot alter an in-flight
    // iterator.
    [Symbol.iterator](): Array<T> {
      return self.to_array();
    }
  end

  // List is the general-purpose growable sequence.
  define class List<T> extends SequenceCore<T> as
    pub map<U>(Fnc<T, U> mapper): List<U> {
      let List<U> output = new List<U>();
      for item of self do
        output.add(mapper(item));
      done
      return output;
    }

    pub filter(Fnc<T, bool> predicate): List<T> {
      let List<T> output = new List<T>();
      for item of self do
        if predicate(item); do
          output.add(item);
        fi
      done
      return output;
    }

  end

  // ArrayList names the contiguous growable-array implementation explicitly.
  define class ArrayList<T> extends SequenceCore<T> as
    pub map<U>(Fnc<T, U> mapper): ArrayList<U> {
      let ArrayList<U> output = new ArrayList<U>();
      for item of self do
        output.add(mapper(item));
      done
      return output;
    }

    pub filter(Fnc<T, bool> predicate): ArrayList<T> {
      let ArrayList<T> output = new ArrayList<T>();
      for item of self do
        if predicate(item); do
          output.add(item);
        fi
      done
      return output;
    }

  end

  // Vector is a growable contiguous vector. Synchronization is intentionally
  // not implicit; shared mutation belongs behind Oreslang Mutex/RwLock policy.
  define class Vector<T> extends SequenceCore<T> as
    pub map<U>(Fnc<T, U> mapper): Vector<U> {
      let Vector<U> output = new Vector<U>();
      for item of self do
        output.add(mapper(item));
      done
      return output;
    }

    pub filter(Fnc<T, bool> predicate): Vector<T> {
      let Vector<T> output = new Vector<T>();
      for item of self do
        if predicate(item); do
          output.add(item);
        fi
      done
      return output;
    }
  end

  define class Stack<T> extends SequenceCore<T> as
    pub peek(): Option<T> {
      return self.last();
    }
  end

  // Two-stack queue: enqueue is O(1), dequeue/peek are amortized O(1).
  define class Queue<T> as
    let Array<T> incoming = new Array<T>();
    let Array<T> outgoing = new Array<T>();

    rebalance(): void {
      if self.outgoing.size == 0; do
        for (let int index = self.incoming.size - 1; index >= 0; index = index - 1) {
          self.outgoing.add(self.incoming.get(index));
        }
        self.incoming.clear();
      fi
      return;
    }

    pub size(): int {
      return self.incoming.size + self.outgoing.size;
    }

    pub is_empty(): bool {
      return self.size() == 0;
    }

    pub enqueue(T value): void {
      self.incoming.add(value);
      return;
    }

    pub dequeue(): Option<T> {
      self.rebalance();
      if self.outgoing.size == 0; do
        return None;
      fi
      return Some(self.outgoing.remove(self.outgoing.size - 1));
    }

    pub peek(): Option<T> {
      self.rebalance();
      if self.outgoing.size == 0; do
        return None;
      fi
      return Some(self.outgoing.get(self.outgoing.size - 1));
    }

    pub clear(): void {
      self.incoming.clear();
      self.outgoing.clear();
      return;
    }

    pub to_array(): Array<T> {
      let Array<T> copy = new Array<T>();
      for (let int index = self.outgoing.size - 1; index >= 0; index = index - 1) {
        copy.add(self.outgoing.get(index));
      }
      for value of self.incoming do
        copy.add(value);
      done
      return copy;
    }

    [Symbol.iterator](): Array<T> {
      return self.to_array();
    }
  end

  // Two-stack deque. front is stored in reverse logical order and back in
  // forward logical order, giving amortized O(1) end operations.
  define class Deque<T> as
    let Array<T> front = new Array<T>();
    let Array<T> back = new Array<T>();

    ensure_front(): void {
      if self.front.size == 0; do
        for (let int index = self.back.size - 1; index >= 0; index = index - 1) {
          self.front.add(self.back.get(index));
        }
        self.back.clear();
      fi
      return;
    }

    ensure_back(): void {
      if self.back.size == 0; do
        for (let int index = self.front.size - 1; index >= 0; index = index - 1) {
          self.back.add(self.front.get(index));
        }
        self.front.clear();
      fi
      return;
    }

    pub size(): int {
      return self.front.size + self.back.size;
    }

    pub is_empty(): bool {
      return self.size() == 0;
    }

    pub push_front(T value): void {
      self.front.add(value);
      return;
    }

    pub push_back(T value): void {
      self.back.add(value);
      return;
    }

    pub pop_front(): Option<T> {
      self.ensure_front();
      if self.front.size == 0; do
        return None;
      fi
      return Some(self.front.remove(self.front.size - 1));
    }

    pub pop_back(): Option<T> {
      self.ensure_back();
      if self.back.size == 0; do
        return None;
      fi
      return Some(self.back.remove(self.back.size - 1));
    }

    pub peek_front(): Option<T> {
      self.ensure_front();
      if self.front.size == 0; do
        return None;
      fi
      return Some(self.front.get(self.front.size - 1));
    }

    pub peek_back(): Option<T> {
      self.ensure_back();
      if self.back.size == 0; do
        return None;
      fi
      return Some(self.back.get(self.back.size - 1));
    }

    pub clear(): void {
      self.front.clear();
      self.back.clear();
      return;
    }

    pub to_array(): Array<T> {
      let Array<T> copy = new Array<T>();
      for (let int index = self.front.size - 1; index >= 0; index = index - 1) {
        copy.add(self.front.get(index));
      }
      for value of self.back do
        copy.add(value);
      done
      return copy;
    }

    [Symbol.iterator](): Array<T> {
      return self.to_array();
    }
  end

  define class ArrayDeque<T> extends Deque<T> as
  end

  // Map policy is implemented in Oreslang over native Array storage. This
  // intentionally keeps key comparison, replacement, iteration order, and
  // removal semantics out of Java. The first implementation is insertion-
  // ordered and linear-search; a hash-index primitive can optimize it later
  // without changing the public API.
  define class MapCore<K, V> as
    let Array<K> keys_store = new Array<K>();
    let Array<V> values_store = new Array<V>();

    find_index(K key): int {
      let int index = 0;
      for current of self.keys_store do
        if current == key; do
          return index;
        fi
        index = index + 1;
      done
      return -1;
    }

    pub size(): int {
      return self.keys_store.size;
    }

    pub is_empty(): bool {
      return self.keys_store.size == 0;
    }

    pub contains_key(K key): bool {
      return self.find_index(key) >= 0;
    }

    pub has(K key): bool {
      return self.contains_key(key);
    }

    pub get(K key): Option<V> {
      val int index = self.find_index(key);
      if index < 0; do
        return None;
      fi
      return Some(self.values_store.get(index));
    }

    pub get_or(K key, V fallback): V {
      val int index = self.find_index(key);
      if index < 0; do
        return fallback;
      fi
      return self.values_store.get(index);
    }

    pub put(K key, V value): Option<V> {
      val int index = self.find_index(key);
      if index >= 0; do
        val V previous = self.values_store.set(index, value);
        return Some(previous);
      fi

      self.keys_store.add(key);
      self.values_store.add(value);
      return None;
    }

    pub set(K key, V value): Option<V> {
      return self.put(key, value);
    }

    pub remove(K key): Option<V> {
      val int index = self.find_index(key);
      if index < 0; do
        return None;
      fi

      val V previous = self.values_store.remove(index);
      self.keys_store.remove(index);
      return Some(previous);
    }

    pub clear(): void {
      self.keys_store.clear();
      self.values_store.clear();
      return;
    }

    pub keys(): Array<K> {
      let Array<K> copy = new Array<K>();
      for key of self.keys_store do
        copy.add(key);
      done
      return copy;
    }

    pub values(): Array<V> {
      let Array<V> copy = new Array<V>();
      for value of self.values_store do
        copy.add(value);
      done
      return copy;
    }
  end

  define class Map<K, V> extends MapCore<K, V> as
  end

  define class OrderedMap<K, V> extends MapCore<K, V> as
  end

  define class Set<T> as
    let Array<T> items = new Array<T>();

    pub size(): int {
      return self.items.size;
    }

    pub is_empty(): bool {
      return self.items.size == 0;
    }

    pub contains(T value): bool {
      for item of self.items do
        if item == value; do
          return true;
        fi
      done
      return false;
    }

    pub add(T value): bool {
      if self.contains(value); do
        return false;
      fi
      self.items.add(value);
      return true;
    }

    pub remove(T value): bool {
      let int index = 0;
      for item of self.items do
        if item == value; do
          self.items.remove(index);
          return true;
        fi
        index = index + 1;
      done
      return false;
    }

    pub clear(): void {
      self.items.clear();
      return;
    }

    pub to_array(): Array<T> {
      let Array<T> copy = new Array<T>();
      for item of self.items do
        copy.add(item);
      done
      return copy;
    }

    [Symbol.iterator](): Array<T> {
      return self.to_array();
    }
  end

end
