import module http_routing from "../src/http_routing";

fnc ok(Result<bool, String> result) -> void {
  stdio.println(result.is_ok());
  return;
}

pub routine main() -> void {
  let router_builder = http_routing.builder();

  val root = http_routing.root();
  val users_new = http_routing.path("/users/new", arr[
    http_routing.literal("users"),
    http_routing.literal("new")
  ]);
  val users_new_details = http_routing.path("/users/new/details", arr[
    http_routing.literal("users"),
    http_routing.literal("new"),
    http_routing.literal("details")
  ]);
  val users_edit = http_routing.path("/users/{id}/edit", arr[
    http_routing.literal("users"),
    http_routing.param("id"),
    http_routing.literal("edit")
  ]);
  val assets = http_routing.path("/assets/*rest", arr[
    http_routing.literal("assets"),
    http_routing.wildcard("rest")
  ]);
  val slash_strict = http_routing.path("/slash/", arr[
    http_routing.literal("slash"),
    http_routing.literal("")
  ]);
  val health = http_routing.path("/health", arr[
    http_routing.literal("health")
  ]);
  val any_path = http_routing.path("/any", arr[
    http_routing.literal("any")
  ]);

  ok(router_builder.get(root, 1));
  ok(router_builder.get(users_new, 2));
  ok(router_builder.get(users_new_details, 3));
  ok(router_builder.get(users_edit, 4, 40, 400, "users.edit"));
  ok(router_builder.get(assets, 5));
  ok(router_builder.get(slash_strict, 6));
  ok(router_builder.get(health, 7));
  ok(router_builder.post(health, 8));
  ok(router_builder.head(health, 9));
  ok(router_builder.any(any_path, 10));

  val router = router_builder.build();

  val root_match = router.resolve("GET", http_routing.request_path(new Array<String>()));
  stdio.println(root_match.is_match());
  stdio.println(root_match.handler_id);

  val static_match = router.resolve("GET", http_routing.request_path(arr["users", "new"]));
  stdio.println(static_match.handler_id);

  // A dead-end static branch must backtrack to the parameter branch.
  val fallback_match = router.resolve("GET", http_routing.request_path(arr["users", "new", "edit"]));
  stdio.println(fallback_match.handler_id);
  stdio.println(router.capture_one(fallback_match, "id").unwrap());
  stdio.println(fallback_match.pipeline_id);
  stdio.println(fallback_match.contract_id);
  stdio.println(fallback_match.operation_id);

  val wildcard_match = router.resolve(
    "GET",
    http_routing.request_path(arr["assets", "css", "main.css"])
  );
  stdio.println(wildcard_match.handler_id);
  val rest = router.capture(wildcard_match, "rest").unwrap();
  stdio.println(rest.size());
  stdio.println(rest.at(0).unwrap());
  stdio.println(rest.at(1).unwrap());

  val empty_wildcard = router.resolve("GET", http_routing.request_path(arr["assets"]));
  stdio.println(empty_wildcard.is_match());
  stdio.println(router.capture(empty_wildcard, "rest").unwrap().size());

  val missing = router.resolve("GET", http_routing.request_path(arr["missing"]));
  stdio.println(missing.is_not_found());

  val wrong_method = router.resolve("DELETE", http_routing.request_path(arr["health"]));
  stdio.println(wrong_method.is_method_not_allowed());
  stdio.println(router.allow_count(wrong_method));
  stdio.println(router.allow_method_at(wrong_method, 0).unwrap());
  stdio.println(router.allow_method_at(wrong_method, 1).unwrap());
  stdio.println(router.allow_method_at(wrong_method, 2).unwrap());
  stdio.println(router.allow_method_at(wrong_method, 3).unwrap());

  val head_match = router.resolve("HEAD", http_routing.request_path(arr["health"]));
  stdio.println(head_match.handler_id);
  stdio.println(head_match.suppress_body);

  val auto_head_builder = http_routing.builder();
  ok(auto_head_builder.get(users_new, 20));
  val auto_head_router = auto_head_builder.build();
  val auto_head = auto_head_router.resolve("HEAD", http_routing.request_path(arr["users", "new"]));
  stdio.println(auto_head.handler_id);
  stdio.println(auto_head.suppress_body);

  val automatic_options = router.resolve("OPTIONS", http_routing.request_path(arr["users", "new"]));
  stdio.println(automatic_options.is_automatic_options());

  val any_match = router.resolve("BREW", http_routing.request_path(arr["any"]));
  stdio.println(any_match.handler_id);

  stdio.println(router.resolve("GET", http_routing.request_path(arr["slash"])).is_not_found());
  stdio.println(router.resolve("GET", http_routing.request_path(arr["slash", ""])).handler_id);

  // Build snapshots are immutable: registrations after build do not alter old routers.
  val later = http_routing.path("/later", arr[http_routing.literal("later")]);
  ok(router_builder.get(later, 11));
  val router_after = router_builder.build();
  stdio.println(router.resolve("GET", http_routing.request_path(arr["later"])).is_not_found());
  stdio.println(router_after.resolve("GET", http_routing.request_path(arr["later"])).handler_id);

  val duplicate = router_builder.get(users_new, 99);
  stdio.println(duplicate.is_err());

  val conflicting_param = http_routing.path("/users/{name}/edit", arr[
    http_routing.literal("users"),
    http_routing.param("name"),
    http_routing.literal("edit")
  ]);
  stdio.println(router_builder.get(conflicting_param, 100).is_err());

  val bad_wildcard = http_routing.path("/bad/*rest/tail", arr[
    http_routing.literal("bad"),
    http_routing.wildcard("rest"),
    http_routing.literal("tail")
  ]);
  stdio.println(router_builder.get(bad_wildcard, 101).is_err());

  val duplicate_capture = http_routing.path("/pair/{id}/{id}", arr[
    http_routing.literal("pair"),
    http_routing.param("id"),
    http_routing.param("id")
  ]);
  stdio.println(router_builder.get(duplicate_capture, 102).is_err());

  let limited_builder = http_routing.builder();
  ok(limited_builder.set_limits(2, 32));
  ok(limited_builder.get(users_new, 200));
  val limited_router = limited_builder.build();
  stdio.println(
    limited_router.resolve(
      "GET",
      http_routing.request_path(arr["users", "new", "extra"])
    ).is_limit_exceeded()
  );
  stdio.println(limited_builder.get(users_edit, 201).is_err());

  // Dynamic capture names may differ when routes diverge after a shared
  // parameter edge; capture metadata belongs to the matched endpoint.
  let divergent_builder = http_routing.builder();
  val users_name_view = http_routing.path("/users/{name}/view", arr[
    http_routing.literal("users"),
    http_routing.param("name"),
    http_routing.literal("view")
  ]);
  ok(divergent_builder.get(users_edit, 300));
  ok(divergent_builder.get(users_name_view, 301));
  val divergent_router = divergent_builder.build();
  val divergent_match = divergent_router.resolve(
    "GET",
    http_routing.request_path(arr["users", "alice", "view"])
  );
  stdio.println(divergent_match.handler_id);
  stdio.println(divergent_router.capture_one(divergent_match, "name").unwrap());
  stdio.println(divergent_router.capture(divergent_match, "id").is_none());

  // Internal catch-all dispatch is not a literal HTTP Allow method.
  stdio.println(router.allow_count(any_match));
  stdio.println(router.allow_method_at(any_match, 0).is_none());

  // Canonical templates and optional metadata sentinels are validated.
  val empty_template = http_routing.path("", arr[
    http_routing.literal("empty")
  ]);
  stdio.println(router_builder.get(empty_template, 302).is_err());

  val metadata_path = http_routing.path("/metadata", arr[
    http_routing.literal("metadata")
  ]);
  stdio.println(router_builder.route("GET", metadata_path, 303, -2, -1, "").is_err());
  stdio.println(router_builder.route("GET", metadata_path, 303, -1, -2, "").is_err());

  // Decisions are safe to reject when accidentally used with another router.
  let foreign_builder = http_routing.builder();
  ok(foreign_builder.get(root, 304));
  val foreign_router = foreign_builder.build();
  stdio.println(foreign_router.capture(static_match, "id").is_none());
  stdio.println(foreign_router.allow_count(static_match));
  stdio.println(foreign_router.allow_method_at(static_match, 0).is_none());

  // Matcher budgets include static fan-out comparisons, not just recursion.
  let fanout_builder = http_routing.builder();
  ok(fanout_builder.set_limits(2, 2));
  ok(fanout_builder.get(http_routing.path("/fan-a", arr[http_routing.literal("fan-a")]), 400));
  ok(fanout_builder.get(http_routing.path("/fan-b", arr[http_routing.literal("fan-b")]), 401));
  ok(fanout_builder.get(http_routing.path("/fan-c", arr[http_routing.literal("fan-c")]), 402));
  val fanout_router = fanout_builder.build();
  stdio.println(
    fanout_router.resolve(
      "GET",
      http_routing.request_path(arr["fan-miss"])
    ).is_limit_exceeded()
  );

  // Configuration cannot raise recursive/CPU safety limits without bound.
  let hard_limit_builder = http_routing.builder();
  stdio.println(hard_limit_builder.set_limits(513, 32).is_err());
  stdio.println(hard_limit_builder.set_limits(2, 65537).is_err());

  // A tiny total budget also bounds ordinary path traversal.
  let step_builder = http_routing.builder();
  ok(step_builder.set_limits(4, 1));
  ok(step_builder.get(users_new, 405));
  val step_router = step_builder.build();
  stdio.println(
    step_router.resolve(
      "GET",
      http_routing.request_path(arr["users", "new"])
    ).is_limit_exceeded()
  );

  return;
}
