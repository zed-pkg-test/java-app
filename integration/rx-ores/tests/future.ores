import * as rx from '../src/rx.ores';
import class Observable, Subscription from '../src/rx.ores';

pub async fnc main(): void {
  val Channel<int> input = Channel.new<int>(1);
  val Future<int> pending = nb readch input;
  writech input, 42;

  val Observable<int> source = rx.from_future(pending);
  let Subscription<int> sub = source.subscribe();
  stdio.println(sub.next().unwrap());
  stdio.println(sub.next().is_none());
  return;
}
