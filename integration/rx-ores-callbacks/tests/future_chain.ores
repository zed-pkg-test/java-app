import * as rx_callbacks from '../src/rx.ores';

async fnc twenty(): int {
  return 20;
}

async fnc twice(int value): int {
  return value * 2;
}

pub fnc main(): void {
  val Fnc<int, int> plus_one = |int value| -> {
    return value + 1;
  };
  val Future<int> mapped =
      rx_callbacks.future_map(twenty(), plus_one);

  val Fnc<int, Future<int>> next = |int value| -> {
    return twice(value);
  };
  val Future<int> composed =
      rx_callbacks.future_compose(mapped, next);

  val Fnc<int, void> observe = |int value| -> {
    stdio.stdout.write("seen:");
    stdio.stdout.write(value);
    stdio.stdout.write(":");
    return;
  };
  val Future<int> observed_future =
      rx_callbacks.future_on_success(composed, observe);

  stdio.stdout.write(await observed_future);

  val Future<int> flat =
      rx_callbacks.future_flat_map(twenty(), next);
  stdio.stdout.write(":");
  stdio.stdout.write(await flat);
  return;
}
